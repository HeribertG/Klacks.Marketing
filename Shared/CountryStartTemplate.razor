@inject IPageContentProvider ContentProvider
@inject ILocalizedScreenshotResolver ScreenshotResolver
@inject ILocalizedVideoCatalog VideoCatalog

@* Start page of a country ("/land-ch", "/fr/land-ch"), shared by all country pages (spec
   docs/plans/marketing-preview-start-2026-10-03.md, wave 1). Eight sections: hero, audience (company size and
   industries), the Monday morning scene with the country's challenges, the feature explorer, the solution cards,
   Klacksy, trust and getting started. Every text of the country content (land-xx.json plus the redesign.json
   defaults) stays reachable - visible, in the explorer's rules chapter or folded into a details element; the
   country-independent texts of the new structure live in start.json. Industry pages keep IndustryPageTemplate.
   PageKey is the country page key ("land-ch", also the route and the content file), Culture the page culture code.
   TODO (owner, wave 2): a new real-time hero clip replaces the Klacksy grouping clip; the example sentences are
   only quoted from the recorded clips and link to the Klacksy chapter until they are stable in the playground. *@
<PageTitle>@Country.PageTitle</PageTitle>
<SeoHead PageKey="@PageKey" Culture="@Culture" RoutePath="@PageKey" Title="@Country.PageTitle" DescriptionSource="@DescriptionSource" IndexTranslatedOnly="true" />

<!-- 1 HERO -->
<header class="pt-20 md:pt-28 pb-12 md:pb-16 px-4 sm:px-8 max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-6 min-w-0">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-surface-container-high rounded-full mb-6">
                <span class="material-symbols-outlined text-secondary text-base" aria-hidden="true">@Country.Hero.BadgeIcon</span>
                <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@((MarkupString)Country.Hero.Badge)</span>
            </div>
            <h1 class="text-[2.125rem] md:text-[2.75rem] lg:text-[3.25rem] leading-[1.1] font-black tracking-tighter text-primary mb-6 hyphens-auto break-words">@Tx("hero.title")</h1>
            <p class="text-lg md:text-xl text-on-surface-variant mb-3 leading-relaxed">@((MarkupString)HeroSubtitle.Lead)</p>
            <p class="text-lg md:text-xl font-bold text-secondary mb-6">@Tx("hero.noLicense")</p>
            <ul class="flex flex-wrap gap-2 list-none p-0 mb-8">
                @foreach (var chip in HeroChips)
                {
                    <li class="inline-flex items-center gap-1.5 rounded-full bg-surface-container-low px-3 py-1.5 text-xs font-semibold text-on-surface-variant">
                        <span class="material-symbols-outlined text-secondary text-sm" aria-hidden="true">check</span>@((MarkupString)chip)
                    </li>
                }
            </ul>
            <div class="flex flex-wrap gap-4">
                <button type="button" @onclick="OpenDemoModal" title="@Sh("cta.demoResetNote")" class="btn-shine bg-secondary text-white px-7 py-4 rounded-xl font-bold hover:opacity-90 transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined" aria-hidden="true">play_circle</span> @Sh("cta.tryButton")
                </button>
                <a href="@InstallationHref" class="px-7 py-4 rounded-xl font-bold text-primary bg-surface-container-low hover:bg-surface-container-high transition-all no-underline flex items-center gap-2">
                    <span class="material-symbols-outlined" aria-hidden="true">download</span> @Sh("cta.downloadButton")
                </a>
            </div>
        </div>
        <div class="lg:col-span-6 min-w-0">
            @if (HasHeroVideo)
            {
                <DemoVideo Culture="@Culture" VideoName="@HeroVideoName"
                           LabelKey="klacksyGroupsAddress.videoLabel" CaptionKey="klacksyGroupsAddress.caption"
                           Width="@DemoCarousels.Klacksy.VideoWidth" Height="@DemoCarousels.Klacksy.VideoHeight" Loop="true" FigureClass="m-0" />
                <p class="text-xs text-on-surface-variant leading-relaxed mt-2 mb-0 flex gap-2">
                    <span class="material-symbols-outlined text-sm" aria-hidden="true">speed</span>
                    <span>@Sh(DemoCarousels.KlacksyVideoNoteKey) @Tx("hero.engineNote")</span>
                </p>
            }
            else if (Country.HeroMockup is not null && Country.HeroMockup.Images.Count > 0)
            {
                <HeroProductMockup Mockup="@Country.HeroMockup" Culture="@Culture" />
            }
        </div>
    </div>
    <div class="mt-10 rounded-2xl bg-surface-container-low p-5 md:p-6">
        <p class="text-sm font-semibold text-primary mt-0 mb-3">@Tx("hero.examplesLabel")</p>
        <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
            @for (var index = 0; index < HeroExampleCount; index++)
            {
                <li>
                    <a href="@ChapterHref(DemoCarousels.KlacksySectionId)" class="text-start rounded-xl bg-surface-container-lowest border border-surface-container-high px-3 py-2 text-sm text-primary no-underline hover:border-secondary transition-colors inline-flex items-start gap-2">
                        <span class="material-symbols-outlined text-secondary text-base" aria-hidden="true">chat</span>
                        <span>@Tx($"hero.example.{index}")</span>
                    </a>
                </li>
            }
        </ul>
    </div>
</header>

<!-- 2 FÜR WEN? -->
<section id="@PageSectionIds.Industries" class="reveal bg-surface-container-low py-14 md:py-20 no-line-rule scroll-mt-24" aria-labelledby="audience-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
        <div class="text-center mb-10">
            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@Tx("audience.eyebrow")</span>
            <h2 id="audience-heading" class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mt-4">@Tx("audience.title")</h2>
        </div>
        <div class="grid lg:grid-cols-2 gap-10">
            <div>
                <h3 class="text-xl font-black mt-0 mb-4">@Tx("audience.sizesTitle")</h3>
                <ul class="space-y-3 list-none p-0 m-0">
                    @foreach (var size in SizeRows)
                    {
                        <li>
                            <a href="@size.Href" class="flex items-start gap-4 rounded-2xl bg-surface-container-lowest p-4 md:p-5 no-underline hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.08)] transition-all">
                                <span class="material-symbols-outlined text-secondary text-2xl" aria-hidden="true">@size.Icon</span>
                                <span class="flex-1 min-w-0">
                                    <span class="block text-primary font-black">@Tx($"audience.{size.Key}.label") <span class="font-semibold text-on-surface-variant text-sm">· @Tx($"audience.{size.Key}.range")</span></span>
                                    <span class="block text-sm text-on-surface-variant leading-relaxed mt-1">@Tx($"audience.{size.Key}.text")</span>
                                </span>
                                <span class="material-symbols-outlined text-secondary icon-directional" aria-hidden="true">arrow_forward</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
            @if (Industries.Count > 0)
            {
                <div>
                    <h3 class="text-xl font-black mt-0 mb-2">@Ix("industries.title")</h3>
                    <p class="text-sm text-on-surface-variant leading-relaxed mb-4">@((MarkupString)Ix("industries.eyebrow")): @((MarkupString)Ix("industries.subtitle"))</p>
                    <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
                        @foreach (var industry in Industries)
                        {
                            <li>
                                <a href="@IndustryHref(industry.Slug)" class="inline-flex items-center gap-2 rounded-full bg-surface-container-lowest px-4 py-2 text-sm font-bold text-primary no-underline hover:bg-surface-container-high transition-colors">
                                    <span class="material-symbols-outlined text-secondary text-base" aria-hidden="true">@industry.Icon</span>@Ix(industry.LabelKey)
                                </a>
                            </li>
                        }
                    </ul>
                    <details class="mt-4 text-sm">
                        <summary class="cursor-pointer font-semibold text-secondary">@Tx("audience.industriesDetails")</summary>
                        <dl class="mt-3 space-y-2">
                            @foreach (var industry in Industries)
                            {
                                <div>
                                    <dt class="font-bold text-primary">@Ix(industry.LabelKey)</dt>
                                    <dd class="m-0 text-on-surface-variant">@((MarkupString)Ix(industry.TextKey))</dd>
                                </div>
                            }
                        </dl>
                    </details>
                </div>
            }
        </div>
    </div>
</section>

<!-- 3 DER MONTAGMORGEN -->
<section class="reveal py-14 md:py-20 px-4 sm:px-8 max-w-7xl mx-auto no-line-rule" aria-labelledby="scene-heading">
    <div class="max-w-3xl mx-auto text-center mb-10">
        <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@Tx("scene.eyebrow")</span>
        <h2 id="scene-heading" class="text-[1.75rem] md:text-[2.25rem] font-black tracking-tight mt-4 mb-4">@Tx("scene.title")</h2>
        <p class="text-on-surface-variant leading-relaxed mb-4">@Tx("scene.text")</p>
        <a href="@ChapterHref(DemoCarousels.RulesSectionId)" class="text-sm font-bold text-secondary no-underline inline-flex items-center gap-1">
            <span class="material-symbols-outlined text-base" aria-hidden="true">play_circle</span> @Tx("scene.videoLink")
        </a>
    </div>
    <h3 class="text-center text-lg font-black mt-0 mb-6">
        <span class="block text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant mb-1">@((MarkupString)(Country.Challenges.Eyebrow ?? string.Empty))</span>
        @((MarkupString)Country.Challenges.Title)
    </h3>
    <ul class="grid md:grid-cols-3 gap-4 md:gap-6 list-none p-0 m-0">
        @foreach (var item in Country.Challenges.Items)
        {
            <li class="rounded-2xl bg-surface-container-low p-5">
                <span class="flex items-center gap-2 font-bold text-primary mb-2">
                    <span class="material-symbols-outlined text-secondary text-xl" aria-hidden="true">@item.Icon</span>@((MarkupString)item.Title)
                </span>
                <span class="block text-sm text-on-surface-variant leading-relaxed">@((MarkupString)item.Text)</span>
            </li>
        }
    </ul>
</section>

<!-- 4 FEATURE-EXPLORER -->
@* Keeps the "#regeln" nav anchor of the site header; the rules chapter is the first one and open by default. *@
<div id="@PageSectionIds.Rules" class="scroll-mt-24" aria-hidden="true"></div>
<FeatureExplorer Culture="@Culture" ContentKey="@StartContentKey" RulesCalendar="@Country.RulesCalendar" KlacksyNote="@Sh(DemoCarousels.KlacksyVideoNoteKey)" />

<!-- 5 WAS KLACKS IHNEN ABNIMMT -->
<section id="@PageSectionIds.Solutions" class="reveal bg-surface-container-low py-14 md:py-20 no-line-rule scroll-mt-24" aria-labelledby="solutions-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
        <div class="text-center mb-10">
            <h2 id="solutions-heading" class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mb-4">@((MarkupString)Country.Solutions.Title)</h2>
            <p class="text-on-surface-variant max-w-2xl mx-auto">@((MarkupString)(Country.Solutions.Subtitle ?? string.Empty))</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 items-start">
            @foreach (var item in Country.Solutions.Items)
            {
                var (lead, rest) = LeadSentence.Split(item.Text);
                <div class="p-6 bg-surface-container-lowest rounded-2xl">
                    <span class="material-symbols-outlined text-secondary text-2xl mb-3" aria-hidden="true">@item.Icon</span>
                    <h3 class="text-base font-bold mt-0 mb-2">@((MarkupString)item.Title)</h3>
                    <p class="text-on-surface-variant text-sm leading-relaxed m-0">@((MarkupString)lead)</p>
                    @if (rest.Length > 0)
                    {
                        <details class="mt-2 text-sm">
                            <summary class="cursor-pointer font-semibold text-secondary">@Tx("solutions.more")</summary>
                            <p class="text-on-surface-variant leading-relaxed mt-2 mb-0">@((MarkupString)rest)</p>
                        </details>
                    }
                    @if (item.Icon == ScenarioSolutionIcon)
                    {
                        <a href="@ChapterHref(DemoCarousels.ScenariosSectionId)" class="text-xs font-bold text-secondary inline-flex items-center gap-1 mt-3 no-underline">
                            <span class="material-symbols-outlined text-sm" aria-hidden="true">play_circle</span> @Tx("solutions.scenarioLink")
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</section>

<!-- 6 KLACKSY -->
@if (Country.Klacksy is not null)
{
    <section id="@PageSectionIds.Klacksy" class="reveal py-14 md:py-20 no-line-rule scroll-mt-24" aria-labelledby="klacksy-heading">
        <div class="max-w-7xl mx-auto px-4 sm:px-8 grid lg:grid-cols-12 gap-8 md:gap-14 items-center">
            <div class="lg:col-span-6">
                @if (!string.IsNullOrEmpty(Country.Klacksy.Eyebrow))
                {
                    <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@((MarkupString)Country.Klacksy.Eyebrow)</span>
                }
                <h2 id="klacksy-heading" class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mt-4 mb-6">@((MarkupString)Country.Klacksy.Title)</h2>
                <p class="text-on-surface-variant leading-relaxed">@((MarkupString)Country.Klacksy.Text)</p>
                <div class="flex flex-wrap gap-6 mt-6">
                    <a href="@ChapterHref(DemoCarousels.KlacksySectionId)" class="text-sm font-bold text-secondary inline-flex items-center gap-1 no-underline">
                        <span class="material-symbols-outlined text-base" aria-hidden="true">play_circle</span> @Tx("klacksySection.videoLink")
                    </a>
                    <a href="@KlacksyPageHref" class="text-sm font-bold text-secondary inline-flex items-center gap-1 no-underline">
                        @Tx("klacksySection.pageLink") <span class="material-symbols-outlined text-base icon-directional" aria-hidden="true">arrow_forward</span>
                    </a>
                </div>
            </div>
            <div class="lg:col-span-6">
                <MagnifiedImage Src="@ScreenshotSrc(Country.Klacksy.ImageFile)" Alt="@Country.Klacksy.ImageAlt" Caption="@Country.Klacksy.ImageCaption" />
            </div>
        </div>
    </section>
}

<!-- 7 VERTRAUEN -->
<section class="reveal bg-surface-container-low py-14 md:py-20 no-line-rule" aria-labelledby="trust-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
        <div class="text-center max-w-3xl mx-auto mb-10">
            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@Tx("trust.eyebrow")</span>
            <h2 id="trust-heading" class="hero-title text-[2rem] md:text-[2.5rem] font-black tracking-tight mt-4 mb-4 hyphens-auto">@((MarkupString)Country.Hero.TitleHtml)</h2>
            <p class="text-on-surface-variant leading-relaxed m-0">@((MarkupString)HeroSubtitle.Remainder)</p>
        </div>
        <ul class="grid md:grid-cols-2 lg:grid-cols-4 gap-5 list-none p-0 m-0">
            @foreach (var point in TrustPoints)
            {
                <li class="rounded-2xl bg-surface-container-lowest p-6">
                    <span class="material-symbols-outlined text-secondary text-2xl" aria-hidden="true">@point.Icon</span>
                    <h3 class="text-base font-bold mt-3 mb-2">@Tx($"trust.{point.Key}.title")</h3>
                    <p class="text-sm text-on-surface-variant leading-relaxed m-0">@Tx($"trust.{point.Key}.text")</p>
                </li>
            }
        </ul>
        <p class="max-w-3xl mx-auto text-center text-sm text-on-surface-variant leading-relaxed mt-8 mb-0">@Tx("trust.costNote")</p>

        <div id="@PageSectionIds.Agents" class="max-w-5xl mx-auto mt-10 rounded-2xl bg-surface-container-lowest border border-surface-container-high p-6 md:p-8 flex flex-col md:flex-row gap-5 md:gap-8 items-start scroll-mt-24">
            <span class="material-symbols-outlined text-secondary text-4xl" aria-hidden="true">hub</span>
            <div class="flex-1 min-w-0">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-secondary-container px-3 py-1 text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-secondary-container">@Tx("agents.eyebrow")</span>
                <h3 class="text-xl md:text-2xl font-black mt-3 mb-3">@Tx("agents.title")</h3>
                <p class="text-on-surface-variant leading-relaxed mt-0 mb-3">@Tx("agents.text")</p>
                <p class="text-sm text-on-surface-variant leading-relaxed mt-0 mb-4">@Tx("agents.limits")</p>
                <a href="@AgentsHowToHref" class="text-sm font-bold text-secondary no-underline inline-flex items-center gap-1">@Tx("agents.link") <span class="material-symbols-outlined text-base icon-directional" aria-hidden="true">arrow_forward</span></a>
            </div>
        </div>

        @if (Country.Stats is not null && Country.Stats.Items.Count > 0)
        {
            <h3 class="text-center text-lg font-black mt-12 mb-6">
                <span class="block text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant mb-1">@((MarkupString)(Country.Stats.Eyebrow ?? string.Empty))</span>
                @((MarkupString)Country.Stats.Title)
            </h3>
            <ul class="grid grid-cols-2 lg:grid-cols-4 gap-5 list-none p-0 m-0 text-center">
                @for (var index = 0; index < Country.Stats.Items.Count; index++)
                {
                    var stat = Country.Stats.Items[index];
                    <li>
                        <span class="block text-[2rem] md:text-[2.5rem] font-black tracking-tighter text-primary leading-none">@FormatStat(stat)<span class="text-secondary">@stat.Suffix</span></span>
                        <span class="block text-sm font-bold text-primary mt-2">@((MarkupString)stat.Label)</span>
                        <span class="block text-xs text-on-surface-variant mt-1">@Tx($"trust.stat.{index}")</span>
                    </li>
                }
            </ul>
        }

        @if (Country.Ticker is not null && Country.Ticker.Items.Count > 0)
        {
            <p class="flex flex-wrap justify-center items-center gap-x-5 gap-y-2 text-sm font-bold text-on-surface-variant mt-12 mb-0">
                <span>@Tx("trust.featuresLabel")</span>
                @foreach (var item in Country.Ticker.Items)
                {
                    <span class="inline-flex items-center gap-1.5"><span class="material-symbols-outlined text-secondary text-lg" aria-hidden="true">@item.Icon</span>@((MarkupString)item.Text)</span>
                }
            </p>
        }

        <div class="flex flex-wrap justify-center gap-6 mt-8 text-sm">
            <a href="@ComparisonHref" class="font-bold text-secondary no-underline inline-flex items-center gap-1"><span class="material-symbols-outlined text-base" aria-hidden="true">compare</span> @Tx("trust.linkComparison")</a>
            <a href="@LicenseHref" class="font-bold text-secondary no-underline inline-flex items-center gap-1"><span class="material-symbols-outlined text-base" aria-hidden="true">gavel</span> @Tx("trust.linkLicense")</a>
            <a href="@InstallationHref" class="font-bold text-secondary no-underline inline-flex items-center gap-1"><span class="material-symbols-outlined text-base" aria-hidden="true">install_desktop</span> @Tx("trust.linkInstallation")</a>
        </div>

        @if (Country.Example is not null)
        {
            <details class="max-w-3xl mx-auto mt-8 rounded-2xl bg-surface-container-lowest p-5 text-sm">
                <summary class="cursor-pointer font-semibold text-primary">@((MarkupString)Country.Example.Eyebrow): @((MarkupString)Country.Example.Title)</summary>
                <p class="text-on-surface-variant leading-relaxed mt-3 mb-0">@((MarkupString)Country.Example.Text)</p>
            </details>
        }
    </div>
</section>

<!-- 8 LOSLEGEN -->
<section id="@PageSectionIds.Download" class="reveal py-14 md:py-20 px-4 sm:px-8 max-w-7xl mx-auto no-line-rule scroll-mt-24" aria-labelledby="start-heading">
    <div class="bg-night rounded-[2rem] py-12 md:py-16 px-6 md:px-8 text-center relative overflow-hidden">
        <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-white/60">@Tx("start.eyebrow")</span>
        <h2 id="start-heading" class="text-[2rem] md:text-[2.75rem] font-black text-white tracking-tighter mt-4 mb-5">@((MarkupString)Country.Cta.Title)</h2>
        <p class="text-white/70 max-w-xl mx-auto mb-3">@((MarkupString)Country.Cta.Text)</p>
        <p class="text-white/70 text-sm max-w-xl mx-auto mb-8">@Sh("cta.openSourceNote")</p>
        <div class="flex flex-wrap justify-center gap-4">
            <button type="button" @onclick="OpenDemoModal" title="@Sh("cta.demoResetNote")" class="btn-shine bg-secondary text-white px-8 py-4 rounded-2xl font-black text-lg hover:scale-105 transition-transform flex items-center gap-3"><span class="material-symbols-outlined" aria-hidden="true">play_circle</span> @Sh("cta.tryButton")</button>
            <a href="@InstallationHref" class="border border-white/30 text-white px-8 py-4 rounded-2xl font-black text-lg hover:bg-white/10 transition-all no-underline flex items-center gap-3"><span class="material-symbols-outlined" aria-hidden="true">download</span> @Sh("cta.downloadButton")</a>
        </div>
    </div>

    @if (Country.Steps is not null && Country.Steps.Items.Count > 0)
    {
        <h3 class="text-center text-xl font-black mt-14 mb-6">
            <span class="block text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant mb-1">@((MarkupString)(Country.Steps.Eyebrow ?? string.Empty))</span>
            @((MarkupString)Country.Steps.Title)
        </h3>
        <ol class="grid md:grid-cols-3 gap-5 list-none p-0 m-0">
            @for (var index = 0; index < Country.Steps.Items.Count; index++)
            {
                var step = Country.Steps.Items[index];
                <li class="rounded-2xl bg-surface-container-low p-6">
                    <span class="flex items-center gap-2 font-bold text-primary mb-2">
                        <span class="w-7 h-7 rounded-full bg-secondary text-white text-sm flex items-center justify-center" aria-hidden="true">@(index + 1)</span>@((MarkupString)step.Title)
                    </span>
                    <span class="block text-sm text-on-surface-variant leading-relaxed">@((MarkupString)step.Text)</span>
                </li>
            }
        </ol>
    }

    <h3 class="text-center text-xl font-black mt-14 mb-2">
        <span class="block text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant mb-1">@Ix("getStarted.eyebrow")</span>
        @Ix("getStarted.title")
    </h3>
    <p class="text-center text-sm text-on-surface-variant max-w-2xl mx-auto mb-6">@((MarkupString)Ix("getStarted.subtitle"))</p>
    <ul class="grid md:grid-cols-2 lg:grid-cols-4 gap-5 list-none p-0 m-0">
        @foreach (var card in GetStartedCards)
        {
            <li class="rounded-2xl bg-surface-container-low p-6 flex flex-col">
                <span class="material-symbols-outlined text-secondary text-2xl" aria-hidden="true">@card.Icon</span>
                <h4 class="text-base font-bold mt-3 mb-2">@Ix($"getStarted.{card.Key}.title")</h4>
                <p class="text-sm text-on-surface-variant leading-relaxed mb-4">@((MarkupString)Ix($"getStarted.{card.Key}.text"))</p>
                @if (card.OpensPlayground)
                {
                    <button type="button" @onclick="OpenDemoModal" title="@Sh("cta.demoResetNote")" class="mt-auto text-start text-sm font-bold text-secondary inline-flex items-center gap-1">@Ix($"getStarted.{card.Key}.button") <span class="material-symbols-outlined text-base icon-directional" aria-hidden="true">arrow_forward</span></button>
                }
                else
                {
                    <a href="@card.Href" target="@card.Target" class="mt-auto text-sm font-bold text-secondary no-underline inline-flex items-center gap-1">@Ix($"getStarted.{card.Key}.button") <span class="material-symbols-outlined text-base icon-directional" aria-hidden="true">arrow_forward</span></a>
                }
            </li>
        }
    </ul>
</section>

@code {
    public const string StartContentKey = "start";
    public const string HeroVideoName = DemoVideo.KlacksyGroupsAddressVideoName;

    private const string IndexContentKey = "index";
    private const string SharedContentKey = "shared";
    private const string ImagesPathPrefix = "images/";
    private const string ScenarioSolutionIcon = "science";
    private const string KlacksySlug = "klacksy";
    private const string ComparisonSlug = "vergleich";
    private const string FragmentSeparator = "#";
    private const string BlankTarget = "_blank";
    private const int HeroExampleCount = 3;

    private static readonly string[] HeroChipKeys = { "hero.trust1", "hero.trust2", "hero.trust4" };

    private static readonly (string Icon, string Key)[] TrustPoints =
    {
        ("code", "openSource"),
        ("shield_lock", "data"),
        ("smart_toy", "ai"),
        ("lock_open", "lockIn"),
    };

    private sealed record SizeRow(string Key, string Icon, string Href);

    private sealed record GetStartedCard(string Key, string Icon, string Href, string? Target, bool OpensPlayground);

    [Parameter, EditorRequired] public required string PageKey { get; set; }

    [Parameter] public string Culture { get; set; } = SupportedCultures.DefaultCode;

    [CascadingParameter(Name = "OpenDemoModal")] public EventCallback OpenDemoModal { get; set; }

    private IndustryPageContent Country => ContentProvider.GetIndustryPage(Culture, PageKey);

    private SupportedCulture CultureRecord => SupportedCultures.All.First(culture => culture.Code == Culture);

    private string CulturePrefix => CultureRecord.UrlSlug.Length == 0 ? string.Empty : $"/{CultureRecord.UrlSlug}";

    private string PageHref => $"{CulturePrefix}/{PageKey}";

    private string DescriptionSource => Country.MetaDescription ?? Country.Hero.Subtitle;

    private (string Lead, string Remainder) HeroSubtitle => LeadSentence.Split(Country.Hero.Subtitle);

    private bool HasHeroVideo => VideoCatalog.Find(HeroVideoName, Culture) is not null;

    private IEnumerable<string> HeroChips
        => HeroChipKeys.Take(2).Select(Ix)
            .Append(Tx("hero.chipLanguages"))
            .Concat(HeroChipKeys.Skip(2).Select(Ix))
            .Append(Tx("hero.chipAgents"));

    private IReadOnlyList<CountryIndustry> Industries => CountryIndustries.ForCountry(PageKey) ?? Array.Empty<CountryIndustry>();

    private IReadOnlyList<SizeRow> SizeRows => new[]
    {
        new SizeRow("small", "storefront", CountryHref(CountryPageLinks.SmallBusinessSlug)),
        new SizeRow("mid", "groups", CountryHref(CountryPageLinks.MidSizeBusinessSlug)),
        new SizeRow("large", "domain", CountryHref(CountryPageLinks.LargeBusinessSlug)),
    };

    private IReadOnlyList<GetStartedCard> GetStartedCards => new[]
    {
        new GetStartedCard("playground", "play_circle", ExternalLinks.PlaygroundUrl, null, OpensPlayground: true),
        new GetStartedCard("download", "download", InstallationHref, null, OpensPlayground: false),
        new GetStartedCard("source", "code", ExternalLinks.GithubUrl, BlankTarget, OpensPlayground: false),
        new GetStartedCard("community", "forum", ExternalLinks.DiscordInviteUrl, BlankTarget, OpensPlayground: false),
    };

    private string InstallationHref => CountryHref(CountryPageLinks.InstallationSlug);

    private string LicenseHref => CountryHref(CountryPageLinks.LicenseSlug);

    private string ComparisonHref => CountryHref(ComparisonSlug);

    private string KlacksyPageHref => CountryHref(KlacksySlug);

    private string AgentsHowToHref => CountryHref(CountryPageLinks.LargeBusinessSlug) + FragmentSeparator + PageSectionIds.Agents;

    private string CountryHref(string slug) => CountryPageLinks.Href(CultureRecord.UrlSlug, PageKey, slug);

    private string IndustryHref(string slug) => $"{PageHref}/{slug}";

    // Absolute page path plus fragment: a bare "#id" would resolve against <base href="/"> and leave the page.
    private string ChapterHref(string sectionId) => PageHref + FragmentSeparator + sectionId;

    private string ScreenshotSrc(string file) => $"{ImagesPathPrefix}{ScreenshotResolver.Resolve(file, Culture)}";

    private string FormatStat(IndustryStatItem item)
        => item.Value.ToString($"N{item.Decimals}", System.Globalization.CultureInfo.GetCultureInfo(Culture));

    private string Tx(string key) => ContentProvider.GetText(Culture, StartContentKey, key);

    private string Ix(string key) => ContentProvider.GetText(Culture, IndexContentKey, key);

    private string Sh(string key) => ContentProvider.GetText(Culture, SharedContentKey, key);
}
