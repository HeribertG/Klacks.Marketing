@* Count-up-Kennzahlen (wwwroot/js/stats-counter.js). Serverseitig steht der
   formatierte Endwert im Markup — ohne JS oder bei prefers-reduced-motion bleibt
   er einfach stehen; das JS zählt beim Viewport-Eintritt hoch und überschreibt
   den Text. *@
<section class="reveal bg-surface-container-low py-24 no-line-rule">
    <div class="max-w-7xl mx-auto px-8">
        <div class="text-center mb-16">
            @if (!string.IsNullOrEmpty(Content.Eyebrow))
            {
                <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@((MarkupString)Content.Eyebrow)</span>
            }
            <h2 class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mt-4">@((MarkupString)Content.Title)</h2>
        </div>
        <div class="reveal-stagger grid grid-cols-2 lg:grid-cols-4 gap-12 text-center">
            @foreach (var item in Content.Items)
            {
                <div>
                    <div class="text-[2.5rem] md:text-[3rem] font-black tracking-tighter text-primary leading-none">
                        <span data-countup
                              data-countup-value="@item.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              data-countup-decimals="@item.Decimals">@FormatValue(item)</span>@if (!string.IsNullOrEmpty(item.Suffix))
                        {<span class="text-secondary">@item.Suffix</span>}
                    </div>
                    <p class="text-sm text-on-surface-variant mt-3 mb-0">@((MarkupString)item.Label)</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public required IndustryStatsSection Content { get; set; }
    [Parameter] public string Culture { get; set; } = SupportedCultures.DefaultCode;

    // Endwert serverseitig in der Seitenkultur formatiert (Tausenderpunkt,
    // Komma etc.), damit er ohne JS bereits korrekt dasteht.
    private string FormatValue(IndustryStatItem item)
    {
        var culture = System.Globalization.CultureInfo.GetCultureInfo(Culture);
        return item.Value.ToString($"N{item.Decimals}", culture);
    }
}
