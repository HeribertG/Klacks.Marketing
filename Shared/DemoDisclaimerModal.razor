@inject IPageContentProvider ContentProvider

@* Playground disclaimer opened by every "Playground" button: public instance, regular reset, no real personal data,
   demo login. IsOpen shows it, Culture is the page culture, OnClose closes it; ContentKey is the content file of the
   demoModal.* texts (shared.json with the Sie form by default, simple.json for the Du form of the simple start page),
   the login label and the short demo-data note always come from shared.json. *@

@if (IsOpen)
{
    <div class="fixed inset-0 z-[60] flex items-center justify-center bg-black/60 px-4" @onclick="Close">
        <div class="glass-nav bg-surface-container-lowest rounded-2xl shadow-2xl max-w-md w-full p-8 relative" @onclick:stopPropagation="true">
            <button type="button" class="absolute top-4 right-4 p-1 text-ink-subtle hover:text-tertiary transition-colors" @onclick="Close" aria-label="@Mx("demoModal.closeAriaLabel")">
                <span class="material-symbols-outlined">close</span>
            </button>
            <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-outlined text-secondary">info</span>
                <h2 class="text-lg font-bold text-tertiary">@Mx("demoModal.title")</h2>
            </div>
            <p class="text-sm text-on-surface-variant leading-relaxed mb-4">@((MarkupString)Mx("demoModal.body"))</p>
            <DemoDataNote Culture="@Culture" Short="true" CssClass="mt-0 mb-4" />
            <div class="bg-tertiary/5 rounded-lg px-4 py-3 mb-4 font-mono text-xs text-on-surface-variant break-all" dir="ltr">
                <span class="block text-ink-subtle mb-1 font-sans font-semibold uppercase tracking-wide text-[0.625rem]">@Sh("cta.demoLoginLabel")</span>
                @ExternalLinks.DemoLoginEmail<br />@ExternalLinks.DemoLoginPassword
            </div>
            <p class="text-xs text-ink-subtle mb-6">@((MarkupString)Mx("demoModal.languageNote"))</p>
            <div class="flex gap-3">
                <button type="button" class="flex-1 px-4 py-2.5 rounded-xl font-semibold text-sm text-ink-muted hover:bg-chrome-hover/50 transition-all" @onclick="Close">@Mx("demoModal.cancelButton")</button>
                <a href="@ExternalLinks.PlaygroundUrl" target="_blank" data-c="PlaygroundContinue" class="flex-1 text-center bg-secondary text-white px-4 py-2.5 rounded-xl font-bold text-sm hover:opacity-90 transition-all no-underline" @onclick="Close">@Mx("demoModal.continueButton")</a>
            </div>
        </div>
    </div>
}

@code {
    public const string DefaultContentKey = "shared";

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Culture { get; set; } = SupportedCultures.DefaultCode;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string ContentKey { get; set; } = DefaultContentKey;

    private Task Close() => OnClose.InvokeAsync();

    private string Sh(string key) => ContentProvider.GetText(Culture, DefaultContentKey, key);

    private string Mx(string key) => ContentProvider.GetText(Culture, ContentKey, key);
}
