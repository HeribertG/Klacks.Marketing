@inject IConfiguration Configuration
@inject IPageContentProvider ContentProvider

<HeadContent>
    <link rel="canonical" href="@CanonicalUrl" />
    @foreach (var culture in SupportedCultures.All)
    {
        <link rel="alternate" hreflang="@culture.Code" href="@AbsoluteUrl(culture)" />
    }
    <link rel="alternate" hreflang="x-default" href="@AbsoluteUrl(SupportedCultures.Default)" />

    @if (!string.IsNullOrEmpty(Description))
    {
        <meta name="description" content="@Description" />
        <meta property="og:description" content="@Description" />
    }
    @if (!string.IsNullOrEmpty(Title))
    {
        <meta property="og:title" content="@Title" />
    }
    <meta property="og:locale" content="@OgLocaleValue" />
    @if (!string.IsNullOrEmpty(OgImage))
    {
        <meta property="og:image" content="@($"{BaseUrl}{OgImage}")" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
    }
</HeadContent>

@* JSON-LD is rendered in the component body, not in HeadContent: the prerendered
   HeadOutlet drops <script> elements, whereas <meta>/<link> survive. Structured
   data is valid anywhere in the document, so body placement is fully supported.
   Each block is a complete <script> element emitted as raw markup so the type stays
   the literal "application/ld+json" (see JsonLdBuilder). *@
@foreach (var script in JsonLdScripts)
{
    @((MarkupString)script)
}

@code {
    private const string IndexContentKey = "index";
    private const string ProductPitchTextKey = "hero.subtitle";
    private const string IndustryTitleKeyFormat = "industries.{0}.title";

    [Parameter, EditorRequired] public required string PageKey { get; set; }
    [Parameter] public string Culture { get; set; } = SupportedCultures.DefaultCode;

    // The URL path segment for canonical/alternate links. Defaults to PageKey,
    // but differs when the content key (e.g. "land-ch-spitex") is not identical
    // to the route (e.g. "land-ch/spitex").
    [Parameter] public string? RoutePath { get; set; }

    // For pages that are served under every country but whose content is the same
    // everywhere (the legal pages): the canonical URL points at the culture's
    // default country, so the other country variants are treated as duplicates of
    // it rather than as separate pages.
    [Parameter] public bool SameForEveryCountry { get; set; }

    // The page title, mirrored into og:title (kept identical to <PageTitle>).
    [Parameter] public string? Title { get; set; }

    // Raw source for the meta description; may contain inline HTML/entities, which
    // are stripped and the result truncated. Null falls back to no description.
    [Parameter] public string? DescriptionSource { get; set; }

    // Optional branch-specific OG image path (e.g. "/images/og-image-spitex.png").
    // If null, no og:image is emitted from SeoHead (falls back to _Layout default).
    [Parameter] public string? OgImage { get; set; }

    // Display name for the sub-page level of the breadcrumb. Country sub-pages
    // whose slug is not an industry (e.g. the installation page) must provide it,
    // since the default derives the name from the industry title keys.
    [Parameter] public string? BreadcrumbName { get; set; }

    private string BaseUrl => (Configuration["Site:BaseUrl"] ?? string.Empty).TrimEnd('/');

    private SupportedCulture CultureRecord => SupportedCultures.All.First(c => c.Code == Culture);

    private string EffectiveRoutePath => string.IsNullOrEmpty(RoutePath) ? PageKey : RoutePath;

    private string RoutePathFor(SupportedCulture culture)
        => SameForEveryCountry
            ? $"{LanguageCountries.DefaultCountryFor(culture.Code)}/{EffectiveRoutePath}"
            : EffectiveRoutePath;

    private string AbsoluteUrl(SupportedCulture culture)
        => SeoUrls.Absolute(BaseUrl, culture, RoutePathFor(culture));

    private string CanonicalUrl => AbsoluteUrl(CultureRecord);

    private string Description => SeoText.ToDescription(DescriptionSource);

    // The country whose territory drives og:locale: the page's own country, or the
    // culture's default country for pages served identically under every country.
    private string CountryPageKey
        => SameForEveryCountry
            ? LanguageCountries.DefaultCountryFor(Culture)
            : CountryIndustries.OwningCountry(PageKey) ?? LanguageCountries.DefaultCountryFor(Culture);

    private string OgLocaleValue => SeoUrls.OgLocale(CultureRecord, CountryPageKey);

    // Product-level pitch, reused as the SoftwareApplication description; localized
    // per culture with a German fallback via the content provider.
    private string ProductDescription
        => SeoText.ToDescription(ContentProvider.GetText(Culture, IndexContentKey, ProductPitchTextKey));

    private IReadOnlyList<string> JsonLdScripts
    {
        get
        {
            var scripts = new List<string>
            {
                JsonLdBuilder.OrganizationScript(BaseUrl),
                JsonLdBuilder.SoftwareApplicationScript(BaseUrl, Culture, ProductDescription),
                JsonLdBuilder.WebSiteScript(BaseUrl, Culture),
            };

            if (BreadcrumbScript is { } breadcrumb)
            {
                scripts.Add(breadcrumb);
            }

            if (FAQPageScript is { } faq)
            {
                scripts.Add(faq);
            }

            return scripts;
        }
    }

    // A breadcrumb (country -> industry) is emitted only on industry sub-pages,
    // where the hierarchy is meaningful; a country page is the section root and a
    // single-item breadcrumb would add nothing.
    private string? BreadcrumbScript
    {
        get
        {
            var country = CountryIndustries.OwningCountry(PageKey);
            if (country is null || PageKey.Length <= country.Length + 1)
            {
                return null;
            }

            var slug = PageKey[(country.Length + 1)..];
            var pageName = BreadcrumbName
                ?? ContentProvider.GetText(Culture, IndexContentKey, string.Format(IndustryTitleKeyFormat, slug));

            return JsonLdBuilder.BreadcrumbScript(
                BaseUrl,
                CultureRecord,
                CountryNames.DisplayName(country),
                country,
                pageName,
                EffectiveRoutePath);
        }
    }

    // FAQPage JSON-LD on industry sub-pages (5 industry-specific questions) and
    // country root pages (4 generic questions). Not on legal/installation pages.
    private string? FAQPageScript
    {
        get
        {
            var country = CountryIndustries.OwningCountry(PageKey);
            if (country is null)
            {
                return null;
            }

            // Country root page (e.g. "land-de") → generic FAQs
            if (PageKey.Length <= country.Length)
            {
                return JsonLdBuilder.FAQPageScript(Culture, null);
            }

            // Industry sub-page (e.g. "land-de-spitex") → industry-specific FAQs
            var slug = PageKey[(country.Length + 1)..];
            var industryTitle = BreadcrumbName
                ?? ContentProvider.GetText(Culture, IndexContentKey, string.Format(IndustryTitleKeyFormat, slug));

            return JsonLdBuilder.FAQPageScript(Culture, industryTitle);
        }
    }
}
