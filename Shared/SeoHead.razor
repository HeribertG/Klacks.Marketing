@inject IConfiguration Configuration

<HeadContent>
    <link rel="canonical" href="@CanonicalUrl" />
    @foreach (var culture in SupportedCultures.All)
    {
        <link rel="alternate" hreflang="@culture.Code" href="@AbsoluteUrl(culture)" />
    }
    <link rel="alternate" hreflang="x-default" href="@AbsoluteUrl(SupportedCultures.Default)" />
</HeadContent>

@code {
    [Parameter, EditorRequired] public required string PageKey { get; set; }
    [Parameter] public string Culture { get; set; } = SupportedCultures.DefaultCode;

    // The URL path segment for canonical/alternate links. Defaults to PageKey,
    // but differs when the content key (e.g. "land-ch-spitex") is not identical
    // to the route (e.g. "land-ch/spitex").
    [Parameter] public string? RoutePath { get; set; }

    // For pages that are served under every country but whose content is the same
    // everywhere (the legal pages): the canonical URL points at the culture's
    // default country, so the other country variants are treated as duplicates of
    // it rather than as separate pages.
    [Parameter] public bool SameForEveryCountry { get; set; }

    private string BaseUrl => (Configuration["Site:BaseUrl"] ?? string.Empty).TrimEnd('/');

    private string EffectiveRoutePath => string.IsNullOrEmpty(RoutePath) ? PageKey : RoutePath;

    private string AbsoluteUrl(SupportedCulture culture)
    {
        var routePath = SameForEveryCountry
            ? $"{LanguageCountries.DefaultCountryFor(culture.Code)}/{EffectiveRoutePath}"
            : EffectiveRoutePath;

        var path = culture.Code == SupportedCultures.DefaultCode
            ? (routePath.Length == 0 ? "/" : $"/{routePath}")
            : (routePath.Length == 0 ? $"/{culture.UrlSlug}" : $"/{culture.UrlSlug}/{routePath}");

        return $"{BaseUrl}{path}";
    }

    private string CanonicalUrl => AbsoluteUrl(SupportedCultures.All.First(c => c.Code == Culture));
}
