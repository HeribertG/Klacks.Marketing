@inject IPageContentProvider ContentProvider

<PageTitle>@Content.PageTitle</PageTitle>
<SeoHead PageKey="@PageKey" Culture="@Culture" />

<!-- HERO -->
<header class="pt-32 pb-20 px-8 max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-12 gap-16 items-center">
        <div class="lg:col-span-7">
            <div class="hero-enter hero-enter-1 inline-flex items-center gap-2 px-3 py-1 bg-surface-container-high rounded-full mb-6">
                <span class="material-symbols-outlined text-secondary text-base">@Content.Hero.BadgeIcon</span>
                <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@((MarkupString)Content.Hero.Badge)</span>
            </div>
            <h1 class="hero-enter hero-enter-2 text-[3.5rem] leading-[1.1] font-black tracking-tighter text-primary mb-6">
                @((MarkupString)Content.Hero.TitleHtml)
            </h1>
            <p class="hero-enter hero-enter-3 text-xl text-on-surface-variant mb-10 max-w-xl leading-relaxed">
                @((MarkupString)Content.Hero.Subtitle)
            </p>
            <div class="hero-enter hero-enter-4 flex flex-wrap gap-4">
                <a href="@CtaHref" class="bg-secondary text-white px-8 py-4 rounded-xl font-bold hover:opacity-90 transition-all flex items-center gap-2 no-underline">@Sh("nav.demoRequest") <span class="material-symbols-outlined icon-directional">arrow_forward</span></a>
                <a href="@HomeHref" class="px-8 py-4 rounded-xl font-bold text-primary hover:bg-surface-container-low transition-all no-underline flex items-center gap-2"><span class="material-symbols-outlined icon-directional">arrow_back</span> @Sh("nav.backToIndustries")</a>
            </div>
        </div>
        <div class="hero-enter hero-enter-3 lg:col-span-5 relative hidden lg:block">
            <div class="bg-surface-container-lowest rounded-2xl shadow-2xl p-3 overflow-hidden">
                <div class="flex items-center justify-between mb-3 px-1">
                    <div class="flex gap-2"><div class="w-3 h-3 rounded-full bg-error"></div><div class="w-3 h-3 rounded-full bg-surface-container-high"></div><div class="w-3 h-3 rounded-full bg-tertiary-fixed-dim"></div></div>
                    <div class="text-[0.6875rem] font-bold tracking-[0.05em] text-on-surface-variant uppercase">@Content.Hero.ScreenshotLabel</div>
                </div>
                <img src="images/@Content.Hero.ScreenshotFile" alt="@Content.Hero.ScreenshotAlt" class="w-full h-auto rounded-lg border border-surface-container-high" loading="eager" />
                @if (!string.IsNullOrEmpty(Content.Hero.ScreenshotCaption))
                {
                    <p class="text-xs text-on-surface-variant mt-3 px-1 mb-0">@Content.Hero.ScreenshotCaption</p>
                }
            </div>
        </div>
    </div>
</header>

<!-- HERAUSFORDERUNGEN -->
<section class="reveal bg-surface-container-low py-24 no-line-rule">
    <div class="max-w-7xl mx-auto px-8">
        <div class="text-center mb-16">
            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@Content.Challenges.Eyebrow</span>
            <h2 class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mt-4">@Content.Challenges.Title</h2>
        </div>
        <div class="reveal-stagger grid md:grid-cols-3 gap-12">
            @foreach (var item in Content.Challenges.Items)
            {
                <div class="flex flex-col items-start">
                    <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container-highest mb-6"><span class="material-symbols-outlined text-primary">@item.Icon</span></div>
                    <h3 class="text-xl font-bold text-primary mb-3">@((MarkupString)item.Title)</h3>
                    <p class="text-on-surface-variant text-sm leading-relaxed">@((MarkupString)item.Text)</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- LÖSUNG -->
<section class="reveal py-32 px-8 max-w-7xl mx-auto">
    <div class="text-center mb-20">
        <h2 class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mb-4">@Content.Solutions.Title</h2>
        <p class="text-on-surface-variant max-w-2xl mx-auto">@((MarkupString)(Content.Solutions.Subtitle ?? string.Empty))</p>
    </div>
    <div class="reveal-stagger grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        @foreach (var item in Content.Solutions.Items)
        {
            <div class="card-hover p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all">
                <span class="material-symbols-outlined text-secondary text-3xl mb-6">@item.Icon</span>
                <h4 class="text-lg font-bold mb-4">@((MarkupString)item.Title)</h4>
                <p class="text-on-surface-variant text-sm leading-relaxed">@((MarkupString)item.Text)</p>
            </div>
        }
    </div>
</section>

@if (Content.ShowRoutePlanning)
{
    <RoutePlanningSection Culture="@Culture" />
}

@if (Content.Example is not null)
{
    <!-- BEISPIEL -->
    <section class="reveal bg-surface-container-low py-24 no-line-rule">
        <div class="max-w-3xl mx-auto px-8 text-center">
            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@Content.Example.Eyebrow</span>
            <h2 class="text-[1.75rem] md:text-[2rem] font-black tracking-tight mt-4 mb-6">@Content.Example.Title</h2>
            <p class="text-on-surface-variant leading-relaxed">@((MarkupString)Content.Example.Text)</p>
        </div>
    </section>
}

<!-- CTA -->
<section class="mx-8 my-24">
    <div class="max-w-7xl mx-auto bg-[#141b2c] rounded-[2rem] py-24 px-8 text-center relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none"><div class="blob-animate absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-secondary rounded-full blur-[120px]"></div></div>
        <h2 class="text-[2.5rem] md:text-[3rem] font-black text-white tracking-tighter mb-6 relative z-10">@Content.Cta.Title</h2>
        <p class="text-white/70 max-w-xl mx-auto mb-10 relative z-10">@((MarkupString)Content.Cta.Text)</p>
        <div class="flex flex-wrap justify-center gap-6 relative z-10"><a href="@CtaHref" class="bg-secondary text-white px-10 py-5 rounded-2xl font-black text-lg hover:scale-105 transition-transform no-underline flex items-center gap-3"><span class="material-symbols-outlined">calendar_month</span> @Sh("nav.demoRequest")</a></div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public required string PageKey { get; set; }
    [Parameter] public string Culture { get; set; } = SupportedCultures.DefaultCode;

    private IndustryPageContent Content => ContentProvider.GetIndustryPage(Culture, PageKey);

    private string HomeHref => Culture == SupportedCultures.DefaultCode ? "/" : $"/{Culture}";
    private string CtaHref => $"{HomeHref}#kontakt";

    private string Sh(string key) => ContentProvider.GetText(Culture, "shared", key);
}
