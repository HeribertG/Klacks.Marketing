@inject IPageContentProvider ContentProvider

<PageTitle>@Content.PageTitle</PageTitle>
<SeoHead PageKey="@PageKey" Culture="@Culture" RoutePath="@EffectiveRoutePath" />

<!-- HERO -->
<header id="branchen" class="pt-32 pb-20 px-8 max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-12 gap-16 items-center">
        <div class="lg:col-span-7">
            <div class="hero-enter hero-enter-1 inline-flex items-center gap-2 px-3 py-1 bg-surface-container-high rounded-full mb-6">
                <span class="material-symbols-outlined text-secondary text-base">@Content.Hero.BadgeIcon</span>
                <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@((MarkupString)Content.Hero.Badge)</span>
            </div>
            <h1 class="hero-enter hero-enter-2 text-[3.5rem] leading-[1.1] font-black tracking-tighter text-primary mb-6">
                @((MarkupString)Content.Hero.TitleHtml)
            </h1>
            <p class="hero-enter hero-enter-3 text-xl text-on-surface-variant mb-10 max-w-xl leading-relaxed">
                @((MarkupString)Content.Hero.Subtitle)
            </p>
            <div class="hero-enter hero-enter-4 flex flex-wrap gap-4">
                <a href="@ExternalLinks.PlaygroundUrl" target="_blank" class="btn-shine bg-secondary text-white px-8 py-4 rounded-xl font-bold hover:opacity-90 transition-all flex items-center gap-2 no-underline">@Sh("nav.tryNow") <span class="material-symbols-outlined icon-directional">arrow_forward</span></a>
                <a href="@HomeHref" class="px-8 py-4 rounded-xl font-bold text-primary hover:bg-surface-container-low transition-all no-underline flex items-center gap-2"><span class="material-symbols-outlined icon-directional">arrow_back</span> @Sh("nav.backToIndustries")</a>
            </div>
        </div>
        <div class="hero-enter hero-enter-3 lg:col-span-5 relative hidden lg:block">
            <MagnifiedImage Src="@($"images/{Content.Hero.ScreenshotFile}")" Alt="@Content.Hero.ScreenshotAlt" Caption="@Content.Hero.ScreenshotCaption" Loading="eager" />
        </div>
    </div>
</header>

<!-- HERAUSFORDERUNGEN -->
<section id="regeln" class="reveal bg-surface-container-low py-24 no-line-rule">
    <div class="max-w-7xl mx-auto px-8">
        <div class="text-center mb-16">
            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@((MarkupString)(Content.Challenges.Eyebrow ?? string.Empty))</span>
            <h2 class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mt-4">@((MarkupString)Content.Challenges.Title)</h2>
        </div>
        <div class="reveal-stagger grid md:grid-cols-3 gap-12">
            @foreach (var item in Content.Challenges.Items)
            {
                <div class="group flex flex-col items-start">
                    <div class="icon-pop w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container-highest mb-6"><span class="material-symbols-outlined text-primary">@item.Icon</span></div>
                    <h3 class="text-xl font-bold text-primary mb-3">@((MarkupString)item.Title)</h3>
                    <p class="text-on-surface-variant text-sm leading-relaxed">@((MarkupString)item.Text)</p>
                </div>
            }
        </div>
    </div>
</section>

@if (Content.OpenSource is not null)
{
    <!-- OPEN SOURCE & ON-PREMISE -->
    <section class="reveal py-24 px-8 max-w-4xl mx-auto text-center no-line-rule">
        @if (!string.IsNullOrEmpty(Content.OpenSource.Eyebrow))
        {
            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@((MarkupString)Content.OpenSource.Eyebrow)</span>
        }
        <h2 class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mt-4 mb-6">@((MarkupString)Content.OpenSource.Title)</h2>
        <p class="text-on-surface-variant leading-relaxed mb-10">@((MarkupString)Content.OpenSource.Text)</p>
        <div class="grid sm:grid-cols-3 gap-8 text-left">
            @foreach (var bullet in Content.OpenSource.Bullets)
            {
                <div class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-secondary text-xl">check_circle</span>
                    <p class="text-sm text-on-surface-variant leading-relaxed m-0">@((MarkupString)bullet)</p>
                </div>
            }
        </div>
    </section>
}

<!-- LÖSUNG -->
<section id="kontrolle" class="reveal py-32 px-8 max-w-7xl mx-auto">
    <div class="text-center mb-20">
        <h2 class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mb-4">@((MarkupString)Content.Solutions.Title)</h2>
        <p class="text-on-surface-variant max-w-2xl mx-auto">@((MarkupString)(Content.Solutions.Subtitle ?? string.Empty))</p>
    </div>
    <div class="reveal-stagger grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        @foreach (var item in Content.Solutions.Items)
        {
            <div class="card-hover p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all">
                <span class="icon-pop material-symbols-outlined text-secondary text-3xl mb-6">@item.Icon</span>
                <h4 class="text-lg font-bold mb-4">@((MarkupString)item.Title)</h4>
                <p class="text-on-surface-variant text-sm leading-relaxed">@((MarkupString)item.Text)</p>
            </div>
        }
    </div>
</section>

@if (Content.ShowRoutePlanning)
{
    <RoutePlanningSection Culture="@Culture" />
}

@if (Content.Klacksy is not null)
{
    <!-- KLACKSY -->
    <section id="klacksy" class="reveal bg-surface-container-low py-24 no-line-rule">
        <div class="max-w-7xl mx-auto px-8 grid lg:grid-cols-12 gap-16 items-center">
            <div class="lg:col-span-6">
                @if (!string.IsNullOrEmpty(Content.Klacksy.Eyebrow))
                {
                    <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@((MarkupString)Content.Klacksy.Eyebrow)</span>
                }
                <h2 class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mt-4 mb-6">@((MarkupString)Content.Klacksy.Title)</h2>
                <p class="text-on-surface-variant leading-relaxed">@((MarkupString)Content.Klacksy.Text)</p>
            </div>
            <div class="lg:col-span-6">
                <MagnifiedImage Src="@($"images/{Content.Klacksy.ImageFile}")" Alt="@Content.Klacksy.ImageAlt" Caption="@Content.Klacksy.ImageCaption" />
            </div>
        </div>
    </section>
}

@if (Content.Example is not null)
{
    <!-- BEISPIEL -->
    <section class="reveal bg-surface-container-low py-24 no-line-rule">
        <div class="max-w-3xl mx-auto px-8 text-center">
            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@((MarkupString)Content.Example.Eyebrow)</span>
            <h2 class="text-[1.75rem] md:text-[2rem] font-black tracking-tight mt-4 mb-6">@((MarkupString)Content.Example.Title)</h2>
            <p class="text-on-surface-variant leading-relaxed">@((MarkupString)Content.Example.Text)</p>
        </div>
    </section>
}

@if (Content.Gallery is not null && Content.Gallery.Items.Count > 0)
{
    <!-- GALLERY -->
    <section class="reveal py-24 px-8 max-w-7xl mx-auto no-line-rule">
        <div class="text-center mb-16">
            @if (!string.IsNullOrEmpty(Content.Gallery.Eyebrow))
            {
                <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@((MarkupString)Content.Gallery.Eyebrow)</span>
            }
            <h2 class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mt-4">@((MarkupString)Content.Gallery.Title)</h2>
            @if (!string.IsNullOrEmpty(Content.Gallery.Subtitle))
            {
                <p class="text-on-surface-variant max-w-2xl mx-auto mt-4">@((MarkupString)Content.Gallery.Subtitle)</p>
            }
        </div>
        <div class="reveal-stagger grid gap-10 items-start @(Content.Gallery.Items.Count == 1 ? "max-w-3xl mx-auto" : Content.Gallery.Items.Count == 2 ? "md:grid-cols-2" : "md:grid-cols-2 lg:grid-cols-3")">
            @foreach (var image in Content.Gallery.Items)
            {
                <div>
                    <MagnifiedImage Src="@($"images/{image.File}")" Alt="@image.Alt" Caption="@image.Caption" />
                </div>
            }
        </div>
    </section>
}

@if (CountryIndustries.HasIndustries(PageKey))
{
    <CountryIndustryGrid CountryPageKey="@PageKey" Culture="@Culture" />
}

<!-- CTA -->
<section id="download" class="mx-8 my-24">
    <div class="max-w-7xl mx-auto bg-[#141b2c] rounded-[2rem] py-24 px-8 text-center relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none">
            <div class="blob-animate absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-secondary rounded-full blur-[120px]"></div>
            <div class="blob-animate-2 absolute -bottom-32 -left-16 w-[480px] h-[480px] bg-secondary-fixed-dim rounded-full blur-[100px]"></div>
        </div>
        <h2 class="text-[2.5rem] md:text-[3rem] font-black text-white tracking-tighter mb-6 relative z-10">@((MarkupString)Content.Cta.Title)</h2>
        <p class="text-white/70 max-w-xl mx-auto mb-10 relative z-10">@((MarkupString)Content.Cta.Text)</p>
        <div class="flex flex-wrap justify-center gap-6 relative z-10">
            <a href="@ExternalLinks.PlaygroundUrl" target="_blank" class="btn-shine bg-secondary text-white px-10 py-5 rounded-2xl font-black text-lg hover:scale-105 transition-transform no-underline flex items-center gap-3"><span class="material-symbols-outlined">play_circle</span> @Sh("cta.tryButton")</a>
            <a href="@DownloadHref" class="border border-white/30 text-white px-10 py-5 rounded-2xl font-black text-lg hover:bg-white/10 transition-all no-underline flex items-center gap-3"><span class="material-symbols-outlined">download</span> @Sh("cta.downloadButton")</a>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public required string PageKey { get; set; }
    [Parameter] public string Culture { get; set; } = SupportedCultures.DefaultCode;

    // The URL path segment used to build in-page links. Defaults to PageKey, but
    // differs when the content key (e.g. "land-ch-spitex") is not identical to the
    // route (e.g. "land-ch/spitex").
    [Parameter] public string? RoutePath { get; set; }

    private string EffectiveRoutePath => string.IsNullOrEmpty(RoutePath) ? PageKey : RoutePath;

    private IndustryPageContent Content => ContentProvider.GetIndustryPage(Culture, PageKey);

    // "Alle Branchen" goes back to the owning country's general page (which lists
    // all of that country's industry sub-pages) when the current page belongs to
    // one, so the active country/culture isn't lost. Falls back to the site root
    // for pages with no country-level industry overview (generic pages, and land-*
    // countries that don't have industry sub-pages yet).
    private string HomeHref
    {
        get
        {
            var owningCountry = CountryIndustries.OwningCountry(PageKey);
            return Culture == SupportedCultures.DefaultCode
                ? (owningCountry is null ? "/" : $"/{owningCountry}")
                : (owningCountry is null ? $"/{Culture}" : $"/{Culture}/{owningCountry}");
        }
    }
    private string PageHref => Culture == SupportedCultures.DefaultCode ? $"/{EffectiveRoutePath}" : $"/{Culture}/{EffectiveRoutePath}";
    private string DownloadHref => $"{PageHref}#download";

    private string Sh(string key) => ContentProvider.GetText(Culture, "shared", key);
}
