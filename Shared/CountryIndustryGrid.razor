@inject IPageContentProvider ContentProvider

@if (Industries is not null)
{
    <!-- COUNTRY INDUSTRY GRID -->
    <section class="reveal py-32 px-8 max-w-7xl mx-auto no-line-rule" id="branchen-grid">
        <div class="text-center mb-20">
            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@Ix("industries.eyebrow")</span>
            <h2 class="text-[2.5rem] font-black tracking-tight mt-4 mb-4">@Ix("industries.title")</h2>
            <p class="text-on-surface-variant max-w-2xl mx-auto">@IxHtml("industries.subtitle")</p>
        </div>
        <div class="reveal-stagger grid md:grid-cols-3 gap-6">
            @foreach (var industry in Industries)
            {
                <a href="@IndustryHref(industry.Slug)" class="card-hover p-6 bg-surface-container-lowest rounded-2xl flex flex-col items-start group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all no-underline">
                    <span class="material-symbols-outlined text-secondary text-3xl mb-4">@industry.Icon</span>
                    <h4 class="text-base font-bold text-primary mb-2">@Ix(industry.LabelKey)</h4>
                    <p class="text-on-surface-variant text-xs leading-relaxed mb-4">@IxHtml(industry.TextKey)</p>
                    <span class="text-xs font-bold text-secondary inline-flex items-center gap-1 mt-auto">@Ix("industries.moreLabel") <span class="material-symbols-outlined text-sm icon-directional">arrow_forward</span></span>
                </a>
            }
        </div>
    </section>
}

@code {
    // The country landing page key whose industry sub-pages are listed, e.g.
    // "land-ch". Renders nothing when the country has no industry sub-pages.
    [Parameter, EditorRequired] public required string CountryPageKey { get; set; }

    // The active culture code; used both to look up localized labels and to keep
    // the culture prefix on the generated industry links.
    [Parameter] public string Culture { get; set; } = SupportedCultures.DefaultCode;

    private IReadOnlyList<CountryIndustry>? Industries => CountryIndustries.ForCountry(CountryPageKey);

    // Builds "/land-ch/<slug>" (or "/<culture>/land-ch/<slug>") so both the active
    // culture and the active country are preserved when switching branches.
    private string IndustryHref(string slug)
        => Culture == SupportedCultures.DefaultCode
            ? $"/{CountryPageKey}/{slug}"
            : $"/{Culture}/{CountryPageKey}/{slug}";

    private string Ix(string key) => ContentProvider.GetText(Culture, "index", key);

    private MarkupString IxHtml(string key) => (MarkupString)Ix(key);
}
