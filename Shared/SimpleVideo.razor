@inject ILocalizedVideoCatalog VideoCatalog

@* Video of the simple start page, played like the demo videos of the expert page (DemoVideo.razor): muted, looping,
   autoplay, no controls; wwwroot/js/rule-conflict-video.js (selector video.rule-demo-video) pauses it outside the
   viewport and in a hidden tab, and under prefers-reduced-motion only the poster image is shown. The video sits in the
   shared screenshot-hover-zoom frame. "VideoPlay" (wwwroot/js/c.js) counts the first start per video and page view,
   i.e. the video reached the viewport. Without webm, mp4 and webp poster in the page culture it renders Fallback
   (default: nothing). VideoName is the base name ("simple-plans-week"), Culture the page culture, Label the accessible
   name, Width/Height the intrinsic size that reserves the layout space. ShowControls adds the native controls (sound can
   be switched on) and drops the hover zoom, for the story clip with ambient sound. *@
@if (_sources is not null)
{
    <div class="@(ShowControls ? null : HoverZoomFrameClass)">
        <video class="rule-demo-video w-full h-auto rounded-2xl shadow-xl bg-surface-container-high"
               muted autoplay loop playsinline preload="metadata" controls="@ShowControls"
               width="@Width" height="@Height"
               poster="@_sources.PosterPath"
               aria-label="@Label"
               data-c-play="VideoPlay">
            <source src="@_sources.WebmPath" type="@WebmMimeType" />
            <source src="@_sources.Mp4Path" type="@Mp4MimeType" />
        </video>
        <img class="rule-demo-poster w-full h-auto rounded-2xl shadow-xl"
             src="@_sources.PosterPath" alt="@Label"
             width="@Width" height="@Height" loading="lazy" />
    </div>
}
else if (Fallback is not null)
{
    @Fallback
}

@code {
    public const string PlansWeekVideoName = "simple-plans-week";
    public const string KlacksyCallVideoName = "simple-klacksy-call";
    public const string StoryComicVideoName = "simple-story-comic";
    public const string WeekplanStoryVideoName = "simple-story-weekplan";
    public const int StoryComicVideoWidth = 1280;
    public const int StoryComicVideoHeight = 720;
    public const int RecordedVideoWidth = 1000;
    public const int RecordedVideoHeight = 720;

    private const string WebmMimeType = "video/webm";
    private const string Mp4MimeType = "video/mp4";
    private const string HoverZoomFrameClass = "screenshot-hover-zoom rounded-2xl";

    private LocalizedVideoSources? _sources;

    [Parameter, EditorRequired] public required string VideoName { get; set; }
    [Parameter] public string Culture { get; set; } = SupportedCultures.DefaultCode;
    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter] public int Width { get; set; } = RecordedVideoWidth;
    [Parameter] public int Height { get; set; } = RecordedVideoHeight;
    [Parameter] public RenderFragment? Fallback { get; set; }
    [Parameter] public bool ShowControls { get; set; }

    protected override void OnParametersSet()
    {
        _sources = VideoCatalog.Find(VideoName, Culture);
    }
}
