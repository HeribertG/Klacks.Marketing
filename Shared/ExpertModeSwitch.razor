@inject NavigationManager Nav
@inject IOptions<SiteModeOptions> ModeOptions
@inject IPageContentProvider ContentProvider
@implements IDisposable

@* Header slider "Expertenmodus" (spec docs/superpowers/specs/2026-10-15-marketing-simple-mode-design.md §3): a real
   link to the opposite page of the same country (SiteModeResolver) with role="switch" and aria-checked, so it works
   before and without the circuit; inside the circuit Blazor's link interception navigates without a reload, and
   wwwroot/js/site-mode.js lets Space activate it like Enter. Off (aria-checked="false") on the simple start page, on
   everywhere else. Hidden in cultures without a simple page and while SimpleMode:Enabled is off. The state is derived
   from the URL on every render and refreshed on every in-circuit navigation; nothing is stored. The label is visually
   hidden below the sm breakpoint but stays the accessible name. *@
@if (State is { ShowSwitch: true, SwitchTarget: { } target })
{
    <a href="@target" role="switch" aria-checked="@(State.IsSimple ? AriaFalse : AriaTrue)" data-c="ExpertToggle" class="mode-switch inline-flex items-center gap-2 cursor-pointer select-none no-underline">
        <span class="mode-switch-track" aria-hidden="true"><span class="mode-switch-thumb"></span></span>
        <span class="sr-only sm:not-sr-only text-sm font-semibold text-primary whitespace-nowrap">@Tx(LabelKey)</span>
    </a>
}

@code {
    private const string LabelKey = "switch.label";
    private const string AriaTrue = "true";
    private const string AriaFalse = "false";

    private SiteModeState State => SiteModeResolver.Resolve(Nav.ToBaseRelativePath(Nav.Uri), ModeOptions.Value.Enabled);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    private string Tx(string key) => ContentProvider.GetText(State.CultureCode, SiteModes.SimpleContentKey, key);

    public void Dispose() => Nav.LocationChanged -= HandleLocationChanged;
}
