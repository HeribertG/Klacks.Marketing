@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IPageContentProvider ContentProvider
@inject IJSRuntime JS
@implements IDisposable

<!-- NAVIGATION BAR -->
<nav class="fixed top-0 w-full z-50 glass-nav no-line-rule">
    <div class="flex justify-between items-center gap-8 w-full px-8 py-4 max-w-7xl mx-auto">
        <a href="@HomeHref" class="flex items-center gap-2 text-2xl font-black tracking-tighter text-black no-underline">
            <img src="images/klacks-logo.svg" class="w-8 h-8" alt="Klacks Logo" />
            Klacks
        </a>
        <div class="hidden md:flex items-center gap-8">
            <a class="nav-link text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="@SectionHref("kontrolle")">@Sh("nav.solution")</a>
            <a class="nav-link text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="@SectionHref("klacksy")">@Sh("nav.klacksy")</a>
            <a class="nav-link text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="@SectionHref("regeln")">@ShHtml("nav.rules")</a>
            @if (ShowIndustryMenu)
            {
                <div class="relative">
                    <button type="button" class="nav-link flex items-center gap-1 text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight" @onclick="ToggleIndustryMenu">
                        @Sh("nav.industries")
                        <span class="material-symbols-outlined text-base">expand_more</span>
                    </button>
                    <div class="dropdown-menu @(_industryMenuOpen ? "dropdown-menu-open" : "") absolute top-full left-0 mt-2 bg-surface-container-lowest rounded-xl shadow-xl border border-surface-container-high py-2 min-w-[12rem]">
                        @foreach (var industry in CurrentCountryIndustries)
                        {
                            <a href="@IndustryHref(industry.Slug)" class="block px-4 py-2 text-sm no-underline hover:bg-surface-container-low @(industry.Slug == CurrentIndustrySlug ? "font-bold text-primary" : "text-on-surface-variant")" @onclick="CloseIndustryMenu">
                                @Ix(industry.LabelKey)
                            </a>
                        }
                    </div>
                </div>
            }
            else
            {
                <a class="nav-link text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="@SectionHref("branchen")">@Sh("nav.industries")</a>
            }
            <a class="nav-link text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="@SectionHref("download")">@Sh("nav.download")</a>
            <a class="nav-link text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="@DocsHref" target="_blank">@Sh("nav.docs")</a>
            <a class="nav-link text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="@ExternalLinks.MarketplaceUrl" target="_blank">@Sh("nav.marketplace")</a>
        </div>
        <div class="hidden md:flex items-center gap-4">
            <div class="relative">
                <button type="button" class="flex items-center gap-1 px-3 py-2 text-slate-600 hover:bg-slate-100/50 rounded-full transition-all text-sm font-bold uppercase" @onclick="ToggleLanguageMenu">
                    @CurrentCultureRecord.Code
                    <span class="material-symbols-outlined text-base">expand_more</span>
                </button>
                <div class="lang-dropdown dropdown-menu @(_languageMenuOpen ? "dropdown-menu-open" : "") absolute top-full right-0 mt-2 bg-surface-container-lowest rounded-xl shadow-xl border border-surface-container-high py-2 min-w-[10rem]">
                    @foreach (var culture in SupportedCultures.All)
                    {
                        <a href="@ResolveLanguageHref(culture)" class="block px-4 py-2 text-sm no-underline hover:bg-surface-container-low @(culture.Code == CurrentCultureRecord.Code ? "font-bold text-primary" : "text-on-surface-variant")" @onclick="CloseLanguageMenu">
                            @culture.NativeName
                        </a>
                    }
                </div>
            </div>
            @if (ShowCountryDropdown)
            {
                <div class="relative">
                    <button type="button" class="flex items-center gap-1.5 px-3 py-2 text-slate-600 hover:bg-slate-100/50 rounded-full transition-all text-sm font-bold uppercase" @onclick="ToggleCountryMenu">
                        <img src="@FlagSrc(CurrentCountryCode)" alt="" class="w-5 h-auto rounded-[2px]" />
                        @CurrentCountryCode
                        <span class="material-symbols-outlined text-base">expand_more</span>
                    </button>
                    <div class="country-dropdown dropdown-menu @(_countryMenuOpen ? "dropdown-menu-open" : "") absolute top-full right-0 mt-2 bg-surface-container-lowest rounded-xl shadow-xl border border-surface-container-high py-2 min-w-[10rem]">
                        @foreach (var country in CurrentLanguageCountries)
                        {
                            <a href="@CountryLanguageHref(CurrentCultureRecord, country)" class="flex items-center gap-2 px-4 py-2 text-sm no-underline hover:bg-surface-container-low @(IsCurrentCountry(country) ? "font-bold text-primary" : "text-on-surface-variant")" @onclick="CloseCountryMenu">
                                <img src="@FlagSrc(CountryCode(country))" alt="" class="w-5 h-auto rounded-[2px]" />
                                @CountryDisplayNames.GetValueOrDefault(country, country)
                            </a>
                        }
                    </div>
                </div>
            }
            <a class="p-2 text-slate-600 hover:bg-slate-100/50 rounded-full transition-all" href="@ExternalLinks.GithubUrl" target="_blank" aria-label="@Sh("nav.githubAriaLabel")">
                <span class="material-symbols-outlined">code</span>
            </a>
            <button type="button" @onclick="OpenDemoModal" class="bg-primary text-on-primary px-6 py-2.5 rounded-xl font-semibold text-sm hover:scale-95 active:scale-90 transition-transform duration-200">
                @Sh("nav.tryNow")
            </button>
        </div>
        <button type="button"
                class="md:hidden p-2 text-slate-600 hover:bg-slate-100/50 rounded-full transition-all"
                aria-label="@(_mobileMenuOpen ? Sh("nav.menuClose") : Sh("nav.menuOpen"))"
                aria-expanded="@(_mobileMenuOpen ? "true" : "false")"
                @onclick="ToggleMobileMenu">
            <span class="material-symbols-outlined">@(_mobileMenuOpen ? "close" : "menu")</span>
        </button>
    </div>

    <div class="mobile-menu-panel @(_mobileMenuOpen ? "mobile-menu-open" : "") glass-nav border-t border-surface-container-high px-8 py-6 flex flex-col gap-5">
        <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="@SectionHref("kontrolle")" @onclick="CloseMobileMenu">@Sh("nav.solution")</a>
        <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="@SectionHref("klacksy")" @onclick="CloseMobileMenu">@Sh("nav.klacksy")</a>
        <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="@SectionHref("regeln")" @onclick="CloseMobileMenu">@ShHtml("nav.rules")</a>
        @if (ShowIndustryMenu)
        {
            <div class="flex flex-col gap-1">
                <span class="text-slate-600 text-sm font-medium tracking-tight">@Sh("nav.industries")</span>
                <div class="flex flex-col border-l border-surface-container-high ml-2 pl-3">
                    @foreach (var industry in CurrentCountryIndustries)
                    {
                        <a href="@IndustryHref(industry.Slug)" class="py-1.5 text-sm no-underline @(industry.Slug == CurrentIndustrySlug ? "font-bold text-primary" : "text-slate-600 hover:text-black")" @onclick="CloseMobileMenu">
                            @Ix(industry.LabelKey)
                        </a>
                    }
                </div>
            </div>
        }
        else
        {
            <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="@SectionHref("branchen")" @onclick="CloseMobileMenu">@Sh("nav.industries")</a>
        }
        <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="@SectionHref("download")" @onclick="CloseMobileMenu">@Sh("nav.download")</a>
        <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="@DocsHref" target="_blank" @onclick="CloseMobileMenu">@Sh("nav.docs")</a>
        <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="@ExternalLinks.MarketplaceUrl" target="_blank" @onclick="CloseMobileMenu">@Sh("nav.marketplace")</a>
        <div class="flex flex-wrap gap-3 pt-2 border-t border-surface-container-high">
            @foreach (var culture in SupportedCultures.All)
            {
                <a href="@ResolveLanguageHref(culture)" class="px-3 py-1 rounded-full text-xs font-bold uppercase no-underline @(culture.Code == CurrentCultureRecord.Code ? "bg-primary text-on-primary" : "bg-surface-container-high text-on-surface-variant")" @onclick="CloseMobileMenu">
                    @culture.Code
                </a>
            }
        </div>
        @if (ShowCountryDropdown)
        {
            <div class="flex flex-wrap gap-3">
                @foreach (var country in CurrentLanguageCountries)
                {
                    <a href="@CountryLanguageHref(CurrentCultureRecord, country)" class="flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase no-underline @(IsCurrentCountry(country) ? "bg-primary text-on-primary" : "bg-surface-container-high text-on-surface-variant")" @onclick="CloseMobileMenu">
                        <img src="@FlagSrc(CountryCode(country))" alt="" class="w-4 h-auto rounded-[2px]" />
                        @CountryDisplayNames.GetValueOrDefault(country, country)
                    </a>
                }
            </div>
        }
        <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline inline-flex items-center gap-2" href="@ExternalLinks.GithubUrl" target="_blank" @onclick="CloseMobileMenu">
            <span class="material-symbols-outlined text-base">code</span> @Sh("nav.github")
        </a>
        <button type="button" class="bg-primary text-on-primary px-6 py-3 rounded-xl font-semibold text-sm text-center" @onclick="OpenDemoModalFromMobileMenu">
            @Sh("nav.tryNow")
        </button>
    </div>
</nav>

<CascadingValue Name="OpenDemoModal" Value="OpenDemoModalCallback">
    @Body
</CascadingValue>

<DemoDisclaimerModal IsOpen="_showDemoModal" Culture="@CurrentCultureRecord.Code" OnClose="CloseDemoModal" />

<!-- FOOTER -->
<footer class="bg-slate-50 no-line-rule">
    <div class="flex flex-col md:flex-row justify-between items-center w-full px-8 py-12 max-w-7xl mx-auto">
        <div class="mb-8 md:mb-0">
            <div class="text-lg font-bold text-black mb-2">Klacks</div>
            <div class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-slate-500">@ShHtml("footer.tagline")</div>
        </div>
        <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">
            <div class="flex flex-wrap justify-center gap-8">
                <a class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-slate-500 hover:text-blue-600 transition-colors no-underline" href="@ExternalLinks.GithubUrl" target="_blank">@Sh("footer.github")</a>
                <a class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-slate-500 hover:text-blue-600 transition-colors no-underline" href="@ExternalLinks.DiscordInviteUrl" target="_blank">@Sh("footer.discord")</a>
                <a class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-slate-500 hover:text-blue-600 transition-colors no-underline" href="mailto:@ExternalLinks.ContactEmail">@Sh("footer.contact")</a>
                <a class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-slate-500 hover:text-blue-600 transition-colors no-underline" href="@ExternalLinks.MarketplaceUrl" target="_blank">@Sh("footer.marketplace")</a>
                <a class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-slate-500 hover:text-blue-600 transition-colors no-underline" href="/impressum">@Sh("footer.imprint")</a>
                <a class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-slate-500 hover:text-blue-600 transition-colors no-underline" href="/datenschutz">@Sh("footer.privacy")</a>
            </div>
            <div class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-slate-500 opacity-80">
                @ShHtml("footer.copyright")
            </div>
        </div>
    </div>
</footer>

@code {
    private static readonly HashSet<string> LocalizedPageKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        string.Empty, "spitex", "spitaeler", "security", "hausdienste", "logistik",
        "land-de", "land-at", "land-ch", "land-sa", "land-ae", "land-il",
        "land-se", "land-ie", "land-cz", "land-gb", "land-ro",
        "land-jp", "land-kr", "land-cn", "land-tw", "land-my", "land-id", "land-th", "land-vn",
        "land-fr", "land-it", "land-nl", "land-be", "land-dk", "land-gr", "land-es", "land-fi", "land-no", "land-pl", "land-pt",
    };

    // On a country landing page ("land-*"), each language maps to the country/
    // countries where it is actually spoken/used for that page, instead of just
    // translating the current country's content. Languages mapping to more than
    // one country show a separate country dropdown (ShowCountryDropdown) to pick
    // from, defaulting to the first entry; languages with no mapped country fall
    // back to the culture's home page.
    private static readonly Dictionary<string, string[]> LanguageCountryMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["de"] = new[] { "land-de", "land-at", "land-ch" },
        ["en"] = new[] { "land-gb", "land-sa", "land-ae", "land-ie" },
        ["ar"] = new[] { "land-sa", "land-ae", "land-il" },
        ["he"] = new[] { "land-il" },
        ["ja"] = new[] { "land-jp" },
        ["ko"] = new[] { "land-kr" },
        ["zh-CN"] = new[] { "land-cn" },
        ["zh-TW"] = new[] { "land-tw" },
        ["ms"] = new[] { "land-my" },
        ["id"] = new[] { "land-id" },
        ["th"] = new[] { "land-th" },
        ["vi"] = new[] { "land-vn" },
        ["cs"] = new[] { "land-cz" },
        ["ro"] = new[] { "land-ro" },
        ["sv"] = new[] { "land-se", "land-fi" },
        ["fr"] = new[] { "land-fr", "land-ch", "land-be" },
        ["it"] = new[] { "land-it", "land-ch" },
        ["nl"] = new[] { "land-nl", "land-be" },
        ["da"] = new[] { "land-dk" },
        ["el"] = new[] { "land-gr" },
        ["es"] = new[] { "land-es" },
        ["fi"] = new[] { "land-fi" },
        ["nb"] = new[] { "land-no" },
        ["pl"] = new[] { "land-pl" },
        ["pt"] = new[] { "land-pt" },
    };

    private static readonly Dictionary<string, string> CountryDisplayNames = new(StringComparer.OrdinalIgnoreCase)
    {
        ["land-de"] = "Deutschland",
        ["land-at"] = "Österreich",
        ["land-ch"] = "Schweiz",
        ["land-sa"] = "Saudi-Arabien",
        ["land-ae"] = "VAE",
        ["land-il"] = "Israel",
        ["land-se"] = "Schweden",
        ["land-ie"] = "Irland",
        ["land-cz"] = "Tschechien",
        ["land-gb"] = "Grossbritannien",
        ["land-ro"] = "Rumänien",
        ["land-jp"] = "Japan",
        ["land-kr"] = "Südkorea",
        ["land-cn"] = "China",
        ["land-tw"] = "Taiwan",
        ["land-my"] = "Malaysia",
        ["land-id"] = "Indonesien",
        ["land-th"] = "Thailand",
        ["land-vn"] = "Vietnam",
        ["land-fr"] = "Frankreich",
        ["land-it"] = "Italien",
        ["land-nl"] = "Niederlande",
        ["land-be"] = "Belgien",
        ["land-dk"] = "Dänemark",
        ["land-gr"] = "Griechenland",
        ["land-es"] = "Spanien",
        ["land-fi"] = "Finnland",
        ["land-no"] = "Norwegen",
        ["land-pl"] = "Polen",
        ["land-pt"] = "Portugal",
    };

    private bool _mobileMenuOpen;
    private bool _languageMenuOpen;
    private bool _countryMenuOpen;
    private bool _industryMenuOpen;
    private bool _showDemoModal;

    private EventCallback OpenDemoModalCallback => EventCallback.Factory.Create(this, OpenDemoModal);

    private void OpenDemoModal() => _showDemoModal = true;

    private void OpenDemoModalFromMobileMenu()
    {
        CloseMobileMenu();
        OpenDemoModal();
    }

    private void CloseDemoModal() => _showDemoModal = false;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("klacksScrollReveal.init");
            await JS.InvokeVoidAsync("klacksMagnifier.init");
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _mobileMenuOpen = false;
        _languageMenuOpen = false;
        _countryMenuOpen = false;
        _industryMenuOpen = false;
        InvokeAsync(async () =>
        {
            var culture = CurrentCultureRecord;
            await JS.InvokeVoidAsync("klacksLocale.applyDirection", culture.IsRtl ? "rtl" : "ltr", culture.Code);
            StateHasChanged();
        });
    }

    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;

    private void CloseMobileMenu() => _mobileMenuOpen = false;

    private void ToggleLanguageMenu()
    {
        _languageMenuOpen = !_languageMenuOpen;
        _countryMenuOpen = false;
    }

    private void CloseLanguageMenu() => _languageMenuOpen = false;

    private void ToggleCountryMenu()
    {
        _countryMenuOpen = !_countryMenuOpen;
        _languageMenuOpen = false;
        _industryMenuOpen = false;
    }

    private void CloseCountryMenu() => _countryMenuOpen = false;

    private void ToggleIndustryMenu()
    {
        _industryMenuOpen = !_industryMenuOpen;
        _languageMenuOpen = false;
        _countryMenuOpen = false;
    }

    private void CloseIndustryMenu() => _industryMenuOpen = false;

    private (string Culture, string PageKey) ResolveCurrentPage()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri).Split('#')[0].Split('?')[0].Trim('/');
        var segments = relativePath.Length == 0 ? Array.Empty<string>() : relativePath.Split('/');

        if (segments.Length > 0)
        {
            var matchedCulture = SupportedCultures.All.FirstOrDefault(c =>
                c.UrlSlug.Length > 0 && c.UrlSlug.Equals(segments[0], StringComparison.OrdinalIgnoreCase));

            if (matchedCulture is not null)
            {
                var pageKeyAfterCulture = segments.Length > 1 ? segments[1] : string.Empty;
                return (matchedCulture.Code, pageKeyAfterCulture);
            }
        }

        var pageKey = segments.Length > 0 ? segments[0] : string.Empty;
        return (SupportedCultures.DefaultCode, pageKey);
    }

    private SupportedCulture CurrentCultureRecord => SupportedCultures.All.First(c => c.Code == ResolveCurrentPage().Culture);

    private string HomeHref => CurrentCultureRecord.Code == SupportedCultures.DefaultCode ? "/land-ch" : $"/{CurrentCultureRecord.UrlSlug}";

    // The raw current relative path (culture + full page key incl. any industry
    // sub-page slug), without fragment/query. Empty string on the site root.
    private string CurrentRelativePath()
        => Nav.ToBaseRelativePath(Nav.Uri).Split('#')[0].Split('?')[0].Trim('/');

    // Anchors to a section on the exact current page. Building from the real path
    // (not the collapsed page key) keeps section links on an industry sub-page
    // (e.g. "/it/land-ch/spitex#regeln") on that page instead of jumping to the
    // country general page, which is what the collapsed key produced.
    private string SectionHref(string anchor)
    {
        var path = CurrentRelativePath();
        return path.Length == 0 ? $"/#{anchor}" : $"/{path}#{anchor}";
    }

    private string DocsHref => CurrentCultureRecord.DocsLocale == SupportedCultures.DefaultCode
        ? ExternalLinks.DocsBasePath
        : $"{ExternalLinks.DocsBasePath}{CurrentCultureRecord.DocsLocale}/";

    private string LanguageSwitchHref(SupportedCulture target)
    {
        var (_, pageKey) = ResolveCurrentPage();
        var effectivePageKey = LocalizedPageKeys.Contains(pageKey) ? pageKey : string.Empty;

        if (target.Code == SupportedCultures.DefaultCode)
        {
            return effectivePageKey.Length == 0 ? "/" : $"/{effectivePageKey}";
        }

        return effectivePageKey.Length == 0 ? $"/{target.UrlSlug}" : $"/{target.UrlSlug}/{effectivePageKey}";
    }

    private bool IsOnCountryPage => ResolveCurrentPage().PageKey.StartsWith("land-", StringComparison.OrdinalIgnoreCase);

    private static string CountryLanguageHref(SupportedCulture target, string pageKey)
        => target.Code == SupportedCultures.DefaultCode ? $"/{pageKey}" : $"/{target.UrlSlug}/{pageKey}";

    // The current country page key ("land-ch" for both the general page and its
    // industry sub-pages, since ResolveCurrentPage collapses the sub-page slug).
    private string CurrentCountryPageKey => ResolveCurrentPage().PageKey;

    // The industry navigation (dropdown + on-page grid) is shown only on a country
    // whose page key has industry sub-pages registered (Switzerland is the pilot).
    private bool ShowIndustryMenu => IsOnCountryPage && CountryIndustries.HasIndustries(CurrentCountryPageKey);

    private IReadOnlyList<CountryIndustry> CurrentCountryIndustries
        => CountryIndustries.ForCountry(CurrentCountryPageKey) ?? Array.Empty<CountryIndustry>();

    // Builds the route to an industry sub-page ("/land-ch/<slug>") keeping both the
    // active culture and the active country. The route uses a slash (not the
    // hyphenated content key).
    private string IndustryHref(string slug)
        => CurrentCultureRecord.Code == SupportedCultures.DefaultCode
            ? $"/{CurrentCountryPageKey}/{slug}"
            : $"/{CurrentCultureRecord.UrlSlug}/{CurrentCountryPageKey}/{slug}";

    // The active industry slug derived from the raw path, since ResolveCurrentPage
    // collapses "/land-ch/spitex" to the "land-ch" page key and cannot report the
    // branch. Empty when not on an industry sub-page.
    private string CurrentIndustrySlug
    {
        get
        {
            var segments = CurrentRelativePath() is { Length: > 0 } p ? p.Split('/') : Array.Empty<string>();

            if (segments.Length > 0 && SupportedCultures.All.Any(c =>
                c.UrlSlug.Length > 0 && c.UrlSlug.Equals(segments[0], StringComparison.OrdinalIgnoreCase)))
            {
                segments = segments[1..];
            }

            return segments.Length >= 2 && segments[0].StartsWith("land-", StringComparison.OrdinalIgnoreCase)
                ? segments[1]
                : string.Empty;
        }
    }

    // Off a country page, language switching only translates the current page
    // (LanguageSwitchHref). On a country page, the language stays on the
    // currently active country when that country also speaks the target
    // language (e.g. de + land-ch -> fr keeps land-ch instead of jumping to
    // land-fr), since the country is the more specific choice the user already
    // made. Only falls back to the language's first mapped country when the
    // active country doesn't speak it; the separate country dropdown
    // (ShowCountryDropdown) lets the user pick a different one when a language
    // maps to several. A language with no mapped country falls back to that
    // language's home page.
    private string ResolveLanguageHref(SupportedCulture target)
    {
        if (!IsOnCountryPage)
        {
            return LanguageSwitchHref(target);
        }

        if (LanguageCountryMap.TryGetValue(target.Code, out var countries) && countries.Length > 0)
        {
            var currentCountry = CurrentCountryPageKey;
            var country = Array.Exists(countries, c => c.Equals(currentCountry, StringComparison.OrdinalIgnoreCase))
                ? currentCountry
                : countries[0];
            return CountryLanguageHref(target, country);
        }

        return target.Code == SupportedCultures.DefaultCode ? "/" : $"/{target.UrlSlug}";
    }

    // Shown on every page (not just /land-*) whenever the active language maps to
    // more than one country — picking an entry always jumps to that country's
    // page. Off a country page there is no "current" country yet, so the first
    // mapped entry is treated as the default (button label + bold highlight).
    private bool ShowCountryDropdown
        => LanguageCountryMap.TryGetValue(CurrentCultureRecord.Code, out var countries) && countries.Length > 1;

    private string[] CurrentLanguageCountries
        => LanguageCountryMap.TryGetValue(CurrentCultureRecord.Code, out var countries) ? countries : Array.Empty<string>();

    private string CurrentCountryCode
    {
        get
        {
            if (IsOnCountryPage)
            {
                return CountryCode(ResolveCurrentPage().PageKey);
            }

            var countries = CurrentLanguageCountries;
            return countries.Length > 0 ? CountryCode(countries[0]) : string.Empty;
        }
    }

    private bool IsCurrentCountry(string pageKey)
    {
        if (IsOnCountryPage)
        {
            return pageKey.Equals(ResolveCurrentPage().PageKey, StringComparison.OrdinalIgnoreCase);
        }

        var countries = CurrentLanguageCountries;
        return countries.Length > 0 && pageKey.Equals(countries[0], StringComparison.OrdinalIgnoreCase);
    }

    private static string CountryCode(string pageKey)
        => pageKey.StartsWith("land-", StringComparison.OrdinalIgnoreCase) ? pageKey["land-".Length..].ToUpperInvariant() : pageKey.ToUpperInvariant();

    // Flag emoji render as bare two-letter text on Windows Chrome/Edge (no
    // color-flag font installed by default), so flags are self-hosted SVGs
    // (MIT-licensed, github.com/lipis/flag-icons) under wwwroot/images/flags/.
    private static string FlagSrc(string twoLetterCode)
        => $"images/flags/{twoLetterCode.ToLowerInvariant()}.svg";

    private string Sh(string key) => ContentProvider.GetText(CurrentCultureRecord.Code, "shared", key);

    private MarkupString ShHtml(string key) => (MarkupString)Sh(key);

    private string Ix(string key) => ContentProvider.GetText(CurrentCultureRecord.Code, "index", key);

    public void Dispose() => Nav.LocationChanged -= HandleLocationChanged;
}
