@inherits LayoutComponentBase
@inject NavigationManager Nav
@implements IDisposable

<!-- NAVIGATION BAR -->
<nav class="fixed top-0 w-full z-50 glass-nav no-line-rule">
    <div class="flex justify-between items-center w-full px-8 py-4 max-w-7xl mx-auto">
        <a href="/" class="flex items-center gap-2 text-2xl font-black tracking-tighter text-black no-underline">
            <img src="images/klacks-logo.svg" class="w-8 h-8" alt="Klacks Logo" />
            Klacks
        </a>
        <div class="hidden md:flex items-center gap-8">
            <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="/#kontrolle">Lösung</a>
            <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="/#klacksy">Klacksy KI</a>
            <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="/#regeln">Regeln &amp; Kalender</a>
            <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="/#branchen">Branchen</a>
        </div>
        <div class="hidden md:flex items-center gap-4">
            <a class="p-2 text-slate-600 hover:bg-slate-100/50 rounded-full transition-all" href="https://github.com/HeribertG/Klacks" target="_blank" aria-label="Quellcode auf GitHub">
                <span class="material-symbols-outlined">code</span>
            </a>
            <a href="/#kontakt" class="bg-primary text-on-primary px-6 py-2.5 rounded-xl font-semibold text-sm hover:scale-95 active:scale-90 transition-transform duration-200 no-underline">
                Demo anfragen
            </a>
        </div>
        <button type="button"
                class="md:hidden p-2 text-slate-600 hover:bg-slate-100/50 rounded-full transition-all"
                aria-label="@(_mobileMenuOpen ? "Menü schliessen" : "Menü öffnen")"
                aria-expanded="@(_mobileMenuOpen ? "true" : "false")"
                @onclick="ToggleMobileMenu">
            <span class="material-symbols-outlined">@(_mobileMenuOpen ? "close" : "menu")</span>
        </button>
    </div>

    @if (_mobileMenuOpen)
    {
        <div class="md:hidden glass-nav border-t border-surface-container-high px-8 py-6 flex flex-col gap-5">
            <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="/#kontrolle" @onclick="CloseMobileMenu">Lösung</a>
            <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="/#klacksy" @onclick="CloseMobileMenu">Klacksy KI</a>
            <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="/#regeln" @onclick="CloseMobileMenu">Regeln &amp; Kalender</a>
            <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline" href="/#branchen" @onclick="CloseMobileMenu">Branchen</a>
            <a class="text-slate-600 hover:text-black transition-colors text-sm font-medium tracking-tight no-underline inline-flex items-center gap-2" href="https://github.com/HeribertG/Klacks" target="_blank" @onclick="CloseMobileMenu">
                <span class="material-symbols-outlined text-base">code</span> Auf GitHub ansehen
            </a>
            <a href="/#kontakt" class="bg-primary text-on-primary px-6 py-3 rounded-xl font-semibold text-sm text-center no-underline" @onclick="CloseMobileMenu">
                Demo anfragen
            </a>
        </div>
    }
</nav>

@Body

<!-- FOOTER -->
<footer class="bg-slate-50 no-line-rule">
    <div class="flex flex-col md:flex-row justify-between items-center w-full px-8 py-12 max-w-7xl mx-auto">
        <div class="mb-8 md:mb-0">
            <div class="text-lg font-bold text-black mb-2">Klacks</div>
            <div class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-slate-500">Personaleinsatzplanung für Schicht- &amp; Einsatzbetriebe</div>
        </div>
        <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">
            <div class="flex gap-8">
                <a class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-slate-500 hover:text-blue-600 transition-colors no-underline" href="https://github.com/HeribertG/Klacks" target="_blank">GitHub</a>
                <a class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-slate-500 hover:text-blue-600 transition-colors no-underline" href="/#kontakt">Kontakt</a>
                <a class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-slate-500 hover:text-blue-600 transition-colors no-underline" href="/datenschutz">Datenschutz</a>
            </div>
            <div class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-slate-500 opacity-80">
                &copy; 2026 Klacks
            </div>
        </div>
    </div>
</footer>

@code {
    private bool _mobileMenuOpen;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_mobileMenuOpen)
        {
            _mobileMenuOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;

    private void CloseMobileMenu() => _mobileMenuOpen = false;

    public void Dispose() => Nav.LocationChanged -= HandleLocationChanged;
}
