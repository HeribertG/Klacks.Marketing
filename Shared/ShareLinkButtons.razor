@inject IPageContentProvider ContentProvider

@* "Link weiterschicken" of the simple start page (spec §5 section 9): a mail template opened in the visitor's own mail
   program and a copy button; no cookie, no storage, the link is also shown as text for manual copying. Both actions
   carry the "ShareClick" event. Copying runs entirely in wwwroot/js/share-link.js inside the click (the clipboard
   needs the click's user activation, e.g. in Safari/iOS, and it works before the circuit is interactive): the button
   carries the URL and both result texts, the script writes the result into the status element of the same block.
   Url is the absolute URL that is shared, Culture the page culture (texts from simple.json), CssClass adds outer
   spacing. The visible URL may only wrap after "//", after each further "/" and before "?": every segment is a
   nowrap span (no break after "-" or "?"), <wbr> between them adds no characters, so selecting it for the
   manual-copy fallback still yields the exact URL. *@
<div data-share-block>
    <div class="flex flex-wrap gap-3 @CssClass">
        <a href="@MailtoHref" data-c="ShareClick" class="inline-flex items-center gap-2 rounded-2xl bg-secondary text-white px-5 py-3 font-bold no-underline hover:opacity-90 transition-all">
            <span class="material-symbols-outlined" aria-hidden="true">mail</span> @Tx("share.mailButton")
        </a>
        <button type="button" data-c="ShareClick" data-share-copy="@Url" data-share-copied="@Tx("share.copied")" data-share-failed="@Tx("share.copyFailed")" class="inline-flex items-center gap-2 rounded-2xl bg-surface-container-high text-primary px-5 py-3 font-bold hover:bg-surface-container-highest transition-all">
            <span class="material-symbols-outlined" aria-hidden="true">content_copy</span> @Tx("share.copyButton")
        </button>
    </div>
    <p class="text-sm text-on-surface-variant mt-3 mb-0 min-h-[1.25rem]" role="status" aria-live="polite" data-share-status></p>
    <p class="text-xs text-on-surface-variant font-mono mt-1 mb-0" dir="ltr" data-share-url>@foreach (var (segment, index) in UrlSegments.Select((segment, index) => (segment, index))){@if (index > 0){<wbr />}<span class="whitespace-nowrap">@segment</span>}</p>
</div>

@code {
    private const string MailBodySeparator = "\n";
    private const string SchemeSeparator = "//";
    private const char PathSeparator = '/';
    private const char QueryStart = '?';

    [Parameter, EditorRequired] public required string Url { get; set; }
    [Parameter] public string Culture { get; set; } = SupportedCultures.DefaultCode;
    [Parameter] public string CssClass { get; set; } = string.Empty;

    private string MailtoHref
        => $"mailto:?subject={Uri.EscapeDataString(Tx("share.mailSubject"))}&body={Uri.EscapeDataString(Tx("share.mailBody") + MailBodySeparator + Url)}";

    private IReadOnlyList<string> UrlSegments => SplitAtBreakPoints(Url);

    private static List<string> SplitAtBreakPoints(string url)
    {
        var segments = new List<string>();
        var schemeEnd = url.IndexOf(SchemeSeparator, StringComparison.Ordinal);
        var start = 0;
        var position = schemeEnd < 0 ? 0 : schemeEnd + SchemeSeparator.Length;
        if (position > 0)
        {
            segments.Add(url[..position]);
            start = position;
        }

        var queryIndex = url.IndexOf(QueryStart);
        var pathEnd = queryIndex < 0 ? url.Length : queryIndex;
        for (; position < pathEnd; position++)
        {
            if (url[position] == PathSeparator && position + 1 < pathEnd)
            {
                segments.Add(url[start..(position + 1)]);
                start = position + 1;
            }
        }

        if (start < pathEnd)
        {
            segments.Add(url[start..pathEnd]);
        }

        if (queryIndex >= 0)
        {
            segments.Add(url[queryIndex..]);
        }

        return segments;
    }

    private string Tx(string key) => ContentProvider.GetText(Culture, SiteModes.SimpleContentKey, key);
}
