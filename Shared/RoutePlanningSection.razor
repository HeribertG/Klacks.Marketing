<!-- ROUTENPLANUNG (wiederverwendbar) -->
<section class="bg-surface-container-low py-32 no-line-rule">
    <div class="max-w-7xl mx-auto px-8 grid lg:grid-cols-2 gap-20 items-center">
        <div>
            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">Routenplanung</span>
            <h2 class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mt-4 mb-6">Die beste Route — automatisch</h2>
            <p class="text-on-surface-variant mb-8 leading-relaxed">Aus den Einsatzadressen rechnet Klacks die sinnvollste Reihenfolge aus und zeigt die fertige Tour auf der Karte. Sie wählen nur noch das Verkehrsmittel.</p>
            <ul class="space-y-6 list-none p-0">
                <li class="flex gap-4">
                    <div class="w-8 h-8 rounded-full bg-secondary text-white flex items-center justify-center font-bold text-sm shrink-0">1</div>
                    <div>
                        <span class="font-bold block text-primary">Adressen erfassen</span>
                        <span class="text-on-surface-variant text-sm">Jeder Einsatzort ist mit Adresse hinterlegt — Klacks kennt die Wege.</span>
                    </div>
                </li>
                <li class="flex gap-4">
                    <div class="w-8 h-8 rounded-full bg-secondary text-white flex items-center justify-center font-bold text-sm shrink-0">2</div>
                    <div>
                        <span class="font-bold block text-primary">Reihenfolge optimieren</span>
                        <span class="text-on-surface-variant text-sm">Klacks legt die kürzeste sinnvolle Abfolge — Umwege und Leerfahrten fallen weg.</span>
                    </div>
                </li>
                <li class="flex gap-4">
                    <div class="w-8 h-8 rounded-full bg-secondary text-white flex items-center justify-center font-bold text-sm shrink-0">3</div>
                    <div>
                        <span class="font-bold block text-primary">Auf der Karte anzeigen</span>
                        <span class="text-on-surface-variant text-sm">Die fertige Tour erscheint als Karte — als Auto-, Velo- oder Fussweg.</span>
                    </div>
                </li>
            </ul>
            <div class="flex flex-wrap gap-3 mt-8">
                <span class="inline-flex items-center gap-2 px-4 py-2 bg-secondary/10 text-secondary rounded-full text-sm font-bold"><span class="material-symbols-outlined text-base">directions_car</span> Auto</span>
                <span class="inline-flex items-center gap-2 px-4 py-2 bg-surface-container-high text-on-surface-variant rounded-full text-sm font-bold"><span class="material-symbols-outlined text-base">directions_bike</span> Velo</span>
                <span class="inline-flex items-center gap-2 px-4 py-2 bg-surface-container-high text-on-surface-variant rounded-full text-sm font-bold"><span class="material-symbols-outlined text-base">directions_walk</span> zu Fuss</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest rounded-2xl shadow-xl p-3 overflow-hidden border border-surface-container-high">
            <div class="flex items-center justify-between mb-3 px-1">
                <div class="flex gap-2">
                    <div class="w-3 h-3 rounded-full bg-error"></div>
                    <div class="w-3 h-3 rounded-full bg-surface-container-high"></div>
                    <div class="w-3 h-3 rounded-full bg-tertiary-fixed-dim"></div>
                </div>
                <div class="text-[0.6875rem] font-bold tracking-[0.05em] text-on-surface-variant uppercase">Tour heute</div>
            </div>
            <svg viewBox="0 0 440 340" class="w-full h-auto rounded-lg" xmlns="http://www.w3.org/2000/svg">
                <rect x="0" y="0" width="440" height="340" rx="8" fill="#eef2f6"/>
                <path d="M-10,90 C120,60 200,150 460,110" stroke="#dde3ea" stroke-width="10" fill="none"/>
                <path d="M60,-10 C90,120 30,220 110,360" stroke="#dde3ea" stroke-width="10" fill="none"/>
                <path d="M-10,250 C150,230 280,300 460,250" stroke="#dde3ea" stroke-width="10" fill="none"/>
                <path d="M330,-10 C300,120 380,200 350,360" stroke="#dde3ea" stroke-width="10" fill="none"/>
                <!-- route line through stops in optimized order -->
                <path d="M70,285 L150,205 L235,250 L305,160 L350,80" fill="none" stroke="#0853ce" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="2 9"/>
                <!-- start / depot -->
                <circle cx="70" cy="285" r="13" fill="#1c1b1f"/>
                <path d="M70,279 l5,5 -5,5 -5,-5 z" fill="#fff"/>
                <text x="70" y="315" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" font-weight="700" fill="#64748b">Start</text>
                <!-- stops -->
                <g font-family="Inter, sans-serif" font-size="13" font-weight="700" fill="#fff" text-anchor="middle">
                    <circle cx="150" cy="205" r="15" fill="#0853ce"/><text x="150" y="210">1</text>
                    <circle cx="235" cy="250" r="15" fill="#0853ce"/><text x="235" y="255">2</text>
                    <circle cx="305" cy="160" r="15" fill="#0853ce"/><text x="305" y="165">3</text>
                    <circle cx="350" cy="80" r="15" fill="#0853ce"/><text x="350" y="85">4</text>
                </g>
            </svg>
            <p class="text-xs text-on-surface-variant mt-3 px-1 mb-0">Stilisiertes Beispiel: Klacks verbindet die Einsatzorte zur kürzesten Tour.</p>
        </div>
    </div>
</section>
