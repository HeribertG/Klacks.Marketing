@inject IPageContentProvider ContentProvider
@inject IConfiguration Configuration

<PageTitle>@Content.PageTitle</PageTitle>
<SeoHead PageKey="@PageKey" Culture="@Culture" RoutePath="@EffectiveRoutePath" Title="@Content.PageTitle" DescriptionSource="@DescriptionSource" BreadcrumbName="@Sh("nav.download")" IndexTranslatedOnly="true" />

<!-- HERO -->
<header class="pt-20 md:pt-32 pb-10 md:pb-16 px-5 sm:px-8 max-w-4xl mx-auto text-center">
    <div class="hero-enter hero-enter-1 inline-flex items-center gap-2 px-3 py-1 bg-surface-container-high rounded-full mb-6">
        <span class="material-symbols-outlined text-secondary text-base">@Content.Hero.BadgeIcon</span>
        <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@((MarkupString)Content.Hero.Badge)</span>
    </div>
    <h1 class="hero-title hero-enter hero-enter-2 text-[2.75rem] md:text-[3.5rem] leading-[1.1] font-black tracking-tighter text-primary mb-6">
        @((MarkupString)Content.Hero.TitleHtml)
    </h1>
    <p class="hero-enter hero-enter-3 text-xl text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
        @((MarkupString)HeroSubtitle)
    </p>
</header>

@if (!PackageAvailable)
{
    <!-- NO COUNTRY PACKAGE NOTICE -->
    <section class="reveal px-5 sm:px-8 max-w-4xl mx-auto pb-10 md:pb-16 no-line-rule">
        <div class="p-6 bg-surface-container-low rounded-2xl flex items-start gap-4">
            <span class="material-symbols-outlined text-secondary text-2xl">info</span>
            <div>
                <span class="font-bold block text-primary mb-1">@((MarkupString)Content.Fallback.NoticeTitle)</span>
                <span class="text-on-surface-variant text-sm leading-relaxed">@((MarkupString)Content.Fallback.NoticeText)</span>
            </div>
        </div>
    </section>
}

<!-- INSTALLATION PATHS -->
@if (NativeSection is not null)
{
    <span id="@PageSectionIds.OfficePc" class="block scroll-mt-24" aria-hidden="true"></span>
}
<section class="reveal pb-14 md:pb-24 px-5 sm:px-8 max-w-7xl mx-auto no-line-rule">
    <div class="reveal-stagger grid @PathGridColumns gap-8 items-stretch">
        @if (NativeSection is { } native)
        {
            <InstallPathCard Path="@native.Path">
                <Actions>
                    <a href="@StoreHref" target="_blank" data-c="DownloadClick" class="btn-shine bg-secondary text-white px-6 py-4 rounded-xl font-bold hover:opacity-90 transition-all inline-flex items-center gap-2 no-underline">
                        <span class="material-symbols-outlined">storefront</span> @native.Path.DownloadLabel
                    </a>
                    <p class="text-sm text-on-surface-variant mt-4 mb-0">@((MarkupString)native.ArchitectureNote)</p>
                    <p class="text-sm text-on-surface-variant mt-2 mb-0">@((MarkupString)native.MacComingSoonNote)</p>
                    <p class="text-sm text-on-surface-variant mt-2 mb-0">@((MarkupString)string.Format(native.LinuxNote, LinuxSectionHref))</p>
                    <p class="text-sm text-on-surface-variant mt-2 mb-0">@((MarkupString)native.UninstallNote)</p>
                </Actions>
            </InstallPathCard>
        }
        <InstallPathCard Path="@Content.OnPrem" StoreUrl="@StoreHref" />
        <InstallPathCard Path="@Content.Compose" StoreUrl="@StoreHref" />
    </div>
</section>

<!-- LINUX PC (always shown, independent of the office-PC switch) -->
<section id="@PageSectionIds.Linux" class="reveal pb-14 md:pb-24 px-5 sm:px-8 max-w-7xl mx-auto no-line-rule scroll-mt-24">
    <div class="p-8 bg-surface-container-lowest rounded-2xl grid md:grid-cols-2 gap-10">
        <div class="flex flex-col">
            <div class="icon-pop w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container-highest mb-6">
                <span class="material-symbols-outlined text-primary">@Content.Linux.Path.Icon</span>
            </div>
            <h2 class="text-2xl font-bold text-primary mb-3">@((MarkupString)Content.Linux.Path.Title)</h2>
            <p class="text-on-surface-variant text-sm leading-relaxed mb-8">@((MarkupString)Content.Linux.Path.Text)</p>

            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant mb-3">@Content.Linux.Path.RequirementsTitle</span>
            <ul class="space-y-2 list-none p-0 mb-8">
                @foreach (var requirement in Content.Linux.Path.Requirements)
                {
                    <li class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-secondary text-xl">check_circle</span>
                        <span class="text-sm text-on-surface-variant leading-relaxed">@((MarkupString)requirement)</span>
                    </li>
                }
            </ul>

            <div class="mt-auto">
                <a href="@StoreHref" target="_blank" data-c="DownloadClick" class="btn-shine bg-secondary text-white px-6 py-4 rounded-xl font-bold hover:opacity-90 transition-all inline-flex items-center gap-2 no-underline">
                    <span class="material-symbols-outlined">storefront</span> @Content.Linux.Path.DownloadLabel
                </a>
            </div>
        </div>
        <div>
            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant mb-3 block">@Content.Linux.Path.StepsTitle</span>
            <ol class="space-y-5 list-none p-0 mb-8">
                @foreach (var (step, index) in Content.Linux.Path.Steps.Select((step, index) => (step, index)))
                {
                    <li class="flex gap-4">
                        <div class="w-8 h-8 rounded-full bg-secondary/10 flex items-center justify-center shrink-0 text-secondary font-bold text-sm">@(index + 1)</div>
                        <div class="min-w-0">
                            <span class="font-bold block text-primary text-sm">@((MarkupString)step.Title)</span>
                            <span class="text-on-surface-variant text-sm">@((MarkupString)step.Text)</span>
                            @if (index == LinuxCommandStepIndex)
                            {
                                <code dir="ltr" class="block mt-3 px-4 py-3 rounded-xl bg-night text-white font-mono text-sm select-all break-all">@LinuxInstallCommand</code>
                            }
                        </div>
                    </li>
                }
            </ol>
            <div class="p-5 bg-surface-container-low rounded-xl flex items-start gap-3">
                <span class="material-symbols-outlined text-secondary text-xl">lock</span>
                <p class="text-on-surface-variant text-sm leading-relaxed m-0">@((MarkupString)Content.Linux.CertificateNote)</p>
            </div>
        </div>
    </div>
</section>

@if (PackageAvailable)
{
    <!-- PROFILE JSON FOR EXISTING INSTALLATIONS -->
    <section class="reveal pb-14 md:pb-24 px-5 sm:px-8 max-w-7xl mx-auto no-line-rule">
        <div class="p-8 bg-surface-container-low rounded-2xl flex flex-col md:flex-row md:items-center gap-6">
            <div class="icon-pop w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container-highest shrink-0">
                <span class="material-symbols-outlined text-primary">@Content.Profile.Icon</span>
            </div>
            <div class="flex-1">
                <h3 class="text-lg font-bold text-primary mb-2">@((MarkupString)Content.Profile.Title)</h3>
                <p class="text-on-surface-variant text-sm leading-relaxed m-0">@((MarkupString)Content.Profile.Text)</p>
            </div>
            <a href="@StoreHref" target="_blank" data-c="DownloadClick" class="px-6 py-3 rounded-xl font-bold text-secondary border border-secondary/30 hover:bg-secondary/5 transition-all no-underline inline-flex items-center gap-2 shrink-0">
                <span class="material-symbols-outlined">storefront</span> @Content.Profile.DownloadLabel
            </a>
        </div>
    </section>
}

<!-- GOOD TO KNOW -->
<section class="reveal bg-surface-container-low py-14 md:py-24 no-line-rule">
    <div class="max-w-7xl mx-auto px-5 sm:px-8">
        <div class="text-center mb-16">
            <h2 class="text-[2rem] md:text-[2.5rem] font-black tracking-tight">@((MarkupString)Content.Notes.Title)</h2>
        </div>
        <div class="reveal-stagger grid md:grid-cols-2 lg:grid-cols-4 gap-10">
            @foreach (var note in Content.Notes.Items)
            {
                <div class="flex flex-col items-start">
                    <div class="icon-pop w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container-highest mb-5"><span class="material-symbols-outlined text-primary">@note.Icon</span></div>
                    <h4 class="text-base font-bold text-primary mb-2">@((MarkupString)note.Title)</h4>
                    <p class="text-on-surface-variant text-sm leading-relaxed m-0">@((MarkupString)note.Text)</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- CTA -->
<section class="mx-8 my-24">
    <div class="max-w-7xl mx-auto bg-night rounded-[2rem] py-14 md:py-24 px-5 sm:px-8 text-center relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none">
            <div class="blob-animate absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-secondary rounded-full blur-[120px]"></div>
            <div class="blob-animate-2 absolute -bottom-32 -left-16 w-[480px] h-[480px] bg-secondary-fixed-dim rounded-full blur-[100px]"></div>
        </div>
        <h2 class="text-[2.5rem] md:text-[3rem] font-black text-white tracking-tighter mb-6 relative z-10">@((MarkupString)Content.Cta.Title)</h2>
        <p class="text-white/70 max-w-xl mx-auto mb-10 relative z-10">@((MarkupString)Content.Cta.Text)</p>
        <div class="flex flex-wrap justify-center gap-6 relative z-10">
            <button type="button" @onclick="OpenDemoModal" data-c="DemoModalOpened" title="@Sh("cta.demoResetNote")" class="btn-shine bg-secondary text-white px-10 py-5 rounded-2xl font-black text-lg hover:scale-105 transition-transform flex items-center gap-3"><span class="material-symbols-outlined">play_circle</span> @Sh("cta.tryButton")</button>
            <a href="@ExternalLinks.GithubUrl" target="_blank" class="border border-white/30 text-white px-10 py-5 rounded-2xl font-black text-lg hover:bg-white/10 transition-all no-underline flex items-center gap-3"><span class="material-symbols-outlined">code</span> @Sh("nav.github")</a>
        </div>
    </div>
</section>

@code {
    private const string MarketplaceBaseUrlConfigKey = "Marketplace:BaseUrl";
    private const string LinuxPackageCommandFormat = "sudo bash install-{0}.sh";
    private const string LinuxFallbackCommand = "sudo bash install.sh";
    private const string FragmentSeparator = "#";
    private const string PathSeparator = "/";

    // Zero-based index of the Linux step ("open a terminal and enter the command") under which the command is shown.
    public const int LinuxCommandStepIndex = 1;

    [Parameter, EditorRequired] public required string PageKey { get; set; }
    [Parameter] public string Culture { get; set; } = SupportedCultures.DefaultCode;
    [Parameter] public string? RoutePath { get; set; }

    [CascadingParameter(Name = "OpenDemoModal")] public EventCallback OpenDemoModal { get; set; }

    private string EffectiveRoutePath => string.IsNullOrEmpty(RoutePath) ? PageKey : RoutePath;

    private InstallPageContent Content => ContentProvider.GetInstallPage(Culture, PageKey);

    private string DescriptionSource => Content.MetaDescription ?? Content.Hero.Subtitle;

    private NativeInstallSettings NativeSettings => NativeInstallSettings.From(Configuration);

    // The office-PC card is shown only when the switch is on and the culture file carries it.
    private InstallNativeSection? NativeSection => NativeSettings.Enabled ? Content.Native : null;

    private string HeroSubtitle => NativeSection?.HeroSubtitle ?? Content.Hero.Subtitle;

    private string PathGridColumns => NativeSection is null ? "lg:grid-cols-2" : "lg:grid-cols-3";

    private string MarketplaceBaseUrl => Configuration[MarketplaceBaseUrlConfigKey] ?? ExternalLinks.MarketplaceUrl;

    // The two-letter marketplace country code derived from the owning country page
    // ("land-ch-installation" -> "ch").
    private string? CountryCode
    {
        get
        {
            var owningCountry = CountryIndustries.OwningCountry(PageKey);
            return owningCountry is null ? null : RegionPackages.CountryCode(owningCountry);
        }
    }

    private bool PackageAvailable => CountryCode is { } code && RegionPackages.HasPackage(code);

    // Every install path is downloaded in the Klacks Store: the country's region page, or the store home
    // for a country without a published package.
    private string StoreHref => RegionPackages.StoreUrl(MarketplaceBaseUrl, CountryCode, Culture);

    // The country package carries a wrapper that presets the region; the standard package only has install.sh.
    private string LinuxInstallCommand
        => PackageAvailable ? string.Format(LinuxPackageCommandFormat, CountryCode) : LinuxFallbackCommand;

    // Absolute page path plus fragment: a bare "#linux" would resolve against <base href="/"> and leave the page.
    private string LinuxSectionHref
    {
        get
        {
            var culture = SupportedCultures.All.First(record => record.Code == Culture);
            var culturePrefix = culture.UrlSlug.Length == 0 ? string.Empty : PathSeparator + culture.UrlSlug;
            return culturePrefix + PathSeparator + EffectiveRoutePath + FragmentSeparator + PageSectionIds.Linux;
        }
    }

    private string Sh(string key) => ContentProvider.GetText(Culture, "shared", key);
}
