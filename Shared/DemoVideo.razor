@inject ILocalizedVideoCatalog VideoCatalog
@inject IPageContentProvider ContentProvider

@* Looping, muted demo video of the app UI recorded in the page culture
   (wwwroot/js/rule-conflict-video.js drives playback for every video.rule-demo-video). Without a
   video in the page culture it renders Fallback (default: nothing) - there is deliberately no
   fallback to another language. Culture is the page culture code; label and caption come from
   shared.json under the given keys; the optional TitleKey adds a heading (styled by TitleClass) above the video.
   Loop (default true) can be turned off for the carousel, which advances on the ended event.
   Deferred renders the video without autoplay and with preload="none" (carousel slides: nothing is
   downloaded until rule-conflict-video.js starts playback of the visible video). HoverZoom puts video and
   poster into the shared screenshot-hover-zoom frame so it enlarges on hover like the page's screenshots.
   CaptionFooter renders inside the figcaption right after the caption (one text block). *@
@if (_sources is not null)
{
    <figure class="@FigureClass">
        @if (TitleKey is not null)
        {
            <h3 class="@TitleClass">@Sh(TitleKey)</h3>
        }
        <div class="@(HoverZoom ? HoverZoomFrameClass : null)">
            <video class="rule-demo-video w-full h-auto rounded-2xl shadow-xl"
                   muted autoplay="@(!Deferred)" loop="@Loop" playsinline preload="@(Deferred ? PreloadNone : PreloadMetadata)"
                   width="@Width" height="@Height"
                   poster="@_sources.PosterPath"
                   aria-label="@Sh(LabelKey)">
                <source src="@_sources.WebmPath" type="@WebmMimeType" />
                <source src="@_sources.Mp4Path" type="@Mp4MimeType" />
            </video>
            <img class="rule-demo-poster w-full h-auto rounded-2xl shadow-xl"
                 src="@_sources.PosterPath" alt="@Sh(LabelKey)"
                 width="@Width" height="@Height" loading="lazy" />
        </div>
        <figcaption class="text-xs text-on-surface-variant mt-3 leading-relaxed text-center mb-0">@((MarkupString)Sh(CaptionKey))@CaptionFooter</figcaption>
    </figure>
}
else if (Fallback is not null)
{
    @Fallback
}

@code {
    public const string RestConflictVideoName = "rest-conflict";
    public const string RuleCollisionVideoName = "rule-collision";
    public const string RuleConsecutiveDaysVideoName = "rule-consecutive-days";
    public const string RuleHolidayWorkVideoName = "rule-holiday-work";
    public const string KlacksyPlansWeekVideoName = "klacksy-plans-week";
    public const string KlacksyGroupsAddressVideoName = "klacksy-groups-address";
    public const string KlacksyGroupsQualificationVideoName = "klacksy-groups-qualification";
    public const string KlacksyGroupsMixedVideoName = "klacksy-groups-mixed";
    public const string ExpensesVideoName = "expenses";
    public const string CorrectionVideoName = "correction";
    public const string ReplacementVideoName = "replacement";
    public const string HoursAdjustmentVideoName = "hours-adjustment";
    public const string Timeline24hVideoName = "timeline-24h";
    public const string TimelineDayDragDropVideoName = "timeline-day-dragdrop";
    public const string ContainerFillVideoName = "container-fill";
    public const string ContainerAutofillVideoName = "container-autofill";
    public const string ContainerPauseVideoName = "container-pause";
    public const string ContainerRouteVideoName = "container-route";
    public const string ContainerSplitVideoName = "container-split";
    public const string ScenarioCreateVideoName = "scenario-create";
    public const string ScenarioAutoWizardVideoName = "scenario-autowizard";
    public const string ScenarioCompareVideoName = "scenario-compare";
    public const string ScenarioRuleViolationVideoName = "scenario-rule-violation";
    public const string ShiftSporadicVideoName = "shift-sporadic";
    public const string ShiftTimeRangeVideoName = "shift-time-range";
    public const string ShiftSumEmployeesVideoName = "shift-sum-employees";
    public const string ShiftQuantityVideoName = "shift-quantity";
    public const string ShiftQualificationVideoName = "shift-qualification";

    private const string WebmMimeType = "video/webm";
    private const string Mp4MimeType = "video/mp4";
    private const string SharedContentKey = "shared";
    private const string PreloadNone = "none";
    private const string PreloadMetadata = "metadata";
    private const string DefaultTitleClass = "text-lg font-bold text-primary mb-4 text-center";
    private const string HoverZoomFrameClass = "screenshot-hover-zoom rounded-2xl";

    private LocalizedVideoSources? _sources;

    [Parameter] public string Culture { get; set; } = SupportedCultures.DefaultCode;
    [Parameter, EditorRequired] public required string VideoName { get; set; }
    [Parameter, EditorRequired] public required string LabelKey { get; set; }
    [Parameter, EditorRequired] public required string CaptionKey { get; set; }
    [Parameter] public string? TitleKey { get; set; }
    [Parameter, EditorRequired] public required int Width { get; set; }
    [Parameter, EditorRequired] public required int Height { get; set; }
    [Parameter] public bool Deferred { get; set; }
    [Parameter] public bool HoverZoom { get; set; }
    [Parameter] public bool Loop { get; set; } = true;
    [Parameter] public string TitleClass { get; set; } = DefaultTitleClass;
    [Parameter] public string FigureClass { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Fallback { get; set; }
    [Parameter] public RenderFragment? CaptionFooter { get; set; }
    protected override void OnParametersSet()
    {
        _sources = VideoCatalog.Find(VideoName, Culture);
    }

    private string Sh(string key) => ContentProvider.GetText(Culture, SharedContentKey, key);
}
