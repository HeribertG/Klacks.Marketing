@* Small fixed "open playground" button for phones on the preview pages (hidden from md upwards, where the hero
   and the navigation carry the call to action). It opens the same demo disclaimer modal as the navigation
   (cascading OpenDemoModal from MainLayout), so the warning about the public test instance is never skipped.
   It sits below the modal (z-[60]) and the navigation (z-50); the page adds bottom padding so it never covers
   the last footer links. Label is the button text. *@
<button type="button"
        class="md:hidden fixed bottom-4 end-4 z-40 inline-flex items-center gap-1.5 rounded-full bg-secondary text-white px-4 py-2.5 text-sm font-bold shadow-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
        style="margin-bottom: env(safe-area-inset-bottom);"
        @onclick="OpenDemoModal">
    <span class="material-symbols-outlined text-base" aria-hidden="true">play_circle</span>
    @Label
</button>

@code {
    [Parameter, EditorRequired] public required string Label { get; set; }

    [CascadingParameter(Name = "OpenDemoModal")] public EventCallback OpenDemoModal { get; set; }
}
