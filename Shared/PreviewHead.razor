@* Head of a hidden preview page (German only, owner review before translation): sets the title and keeps
   search engines out with noindex,nofollow. Deliberately not SeoHead, which would emit canonical, hreflang and
   JSON-LD for a URL that must not be indexed. Title is the page title, Description the optional meta description. *@
<PageTitle>@Title</PageTitle>
<HeadContent>
    <meta name="robots" content="@RobotsValue" />
    @if (!string.IsNullOrEmpty(Description))
    {
        <meta name="description" content="@Description" />
    }
</HeadContent>

@code {
    public const string RobotsValue = "noindex,nofollow";

    [Parameter, EditorRequired] public required string Title { get; set; }

    [Parameter] public string? Description { get; set; }
}
