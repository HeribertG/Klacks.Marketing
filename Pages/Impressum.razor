@page "/{country}/impressum"
@page "/{culture}/{country}/impressum"
@inject IPageContentProvider ContentProvider

<PageTitle>Klacks | @Lx("imprint.title")</PageTitle>
<SeoHead PageKey="impressum" Culture="@ResolvedCulture" SameForEveryCountry="true" Title="@($"Klacks | {Lx("imprint.title")}")" DescriptionSource="@Lx("imprint.contentHtml")" />

<header class="pt-32 pb-16 px-8 max-w-3xl mx-auto">
    <h1 class="text-[2.5rem] font-black tracking-tight text-primary mb-10">@Lx("imprint.title")</h1>
    <div class="legal-prose">@LxHtml("imprint.contentHtml")</div>
</header>

@code {
    [Parameter] public string? Culture { get; set; }

    // Present so the route binds; the imprint content itself is company-wide and
    // does not vary by country.
    [Parameter] public string? Country { get; set; }

    private string ResolvedCulture => SupportedCultures.Resolve(Culture).Code;

    private string Lx(string key) => ContentProvider.GetText(ResolvedCulture, "legal", key);

    private MarkupString LxHtml(string key) => (MarkupString)Lx(key);
}
