@page "/{country}/experten"
@inject IOptions<SiteModeOptions> SiteModeOptions

@* Expert start page for German-speaking visitors ("/land-ch/experten"): today's CountryStartTemplate unchanged, behind
   the expert-mode switch, while "/land-ch" shows the simple start page (spec
   docs/superpowers/specs/2026-10-15-marketing-simple-mode-design.md §3). German only in stage 1, so there is no
   culture-prefixed route; the canonical points at itself and no hreflang set is emitted. Answers 404 while
   SimpleMode:Enabled is off (Program.cs); the component renders NotFoundNotice itself in that case and for an unknown
   country, because navigation inside the Blazor circuit never passes the HTTP guard. Country is the country page key
   of the route; upper case is normalised because the content files are lower case. *@
@if (IsAvailable)
{
    <CountryStartTemplate PageKey="@CountryKey" Culture="@SupportedCultures.DefaultCode" RoutePath="@SiteModes.ExpertRoutePath(CountryKey)" SuppressHreflang="true" />
}
else
{
    <NotFoundNotice />
}

@code {
    [Parameter] public string Country { get; set; } = string.Empty;

    private string CountryKey => Country.ToLowerInvariant();

    private bool IsAvailable
        => SiteModes.HasSimplePage(SupportedCultures.DefaultCode, SiteModeOptions.Value.Enabled)
            && CountryIndustries.AllCountries.Contains(CountryKey, StringComparer.Ordinal);
}
