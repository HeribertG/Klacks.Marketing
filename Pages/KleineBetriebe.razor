@page "/{country}/kleine-betriebe"
@page "/{culture}/{country}/kleine-betriebe"
@inject IPageContentProvider ContentProvider

<PageTitle>@GetText("pageTitle")</PageTitle>
<SeoHead PageKey="@PageKey" Culture="@ResolvedCulture" RoutePath="@PageKey" SameForEveryCountry="true" Title="@GetText("pageTitle")" DescriptionSource="@GetText("metaDescription")" />

<div class="min-h-screen bg-surface text-on-surface">
    <section class="max-w-5xl mx-auto pt-14 md:pt-24 pb-10 md:pb-16 px-5 sm:px-8 text-center">
        <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@GetText("hero.badge")</span>
        <h1 class="text-4xl md:text-5xl font-black tracking-tight mt-4 mb-6">
            @GetText("hero.title")
        </h1>
        <p class="text-xl text-on-surface-variant max-w-3xl mx-auto leading-relaxed">
            @GetText("hero.subtitle")
        </p>
        <p class="text-lg font-semibold text-secondary max-w-3xl mx-auto mt-6">
            @GetText("hero.growth")
        </p>
    </section>

    <section class="max-w-4xl mx-auto py-8 md:py-12 px-5 sm:px-8">
        <h2 class="text-2xl font-bold mb-8">@GetText("benefits.title")</h2>
        <div class="grid md:grid-cols-3 gap-6">
            @foreach (var (icon, index) in BenefitItems)
            {
                <div class="bg-surface-container rounded-xl p-6">
                    <span class="material-symbols-outlined text-secondary text-2xl mb-3">@icon</span>
                    <h3 class="font-bold mb-2">@GetText($"benefits.items.{index}.title")</h3>
                    <p class="text-sm text-on-surface-variant">@GetText($"benefits.items.{index}.text")</p>
                </div>
            }
        </div>
    </section>

    <CountryIndustryGrid CountryPageKey="@CountryKey" Culture="@ResolvedCulture" />

    <section class="max-w-4xl mx-auto py-8 md:py-12 px-5 sm:px-8">
        <h2 class="text-2xl font-bold mb-3">@GetText("needs.title")</h2>
        <p class="text-on-surface-variant mb-8">@GetText("needs.subtitle")</p>
        <div class="grid md:grid-cols-2 gap-6 mb-6">
            <div class="bg-surface-container rounded-xl p-6">
                <div class="flex items-center gap-2 mb-4">
                    <span class="material-symbols-outlined text-secondary text-2xl">computer</span>
                    <h3 class="font-bold">@GetText("needs.pc.title")</h3>
                </div>
                <ul class="list-disc pl-5 space-y-2 text-sm text-on-surface-variant">
                    @for (var i = 0; i < PcItemCount; i++)
                    {
                        <li>@GetText($"needs.pc.items.{i}")</li>
                    }
                </ul>
            </div>
            <div class="bg-surface-container rounded-xl p-6">
                <div class="flex items-center gap-2 mb-4">
                    <span class="material-symbols-outlined text-secondary text-2xl">dns</span>
                    <h3 class="font-bold">@GetText("needs.server.title")</h3>
                </div>
                <ul class="list-disc pl-5 space-y-2 text-sm text-on-surface-variant">
                    @for (var i = 0; i < ServerItemCount; i++)
                    {
                        <li>@GetText($"needs.server.items.{i}")</li>
                    }
                </ul>
            </div>
        </div>
        <p class="text-sm text-on-surface-variant mb-6">@GetText("needs.note")</p>
        <a href="@InstallationHref" class="bg-secondary text-white px-8 py-4 rounded-xl font-bold hover:opacity-90 transition-all no-underline inline-flex items-center gap-2">
            <span class="material-symbols-outlined">install_desktop</span> @GetText("needs.button")
        </a>
    </section>

    <section class="max-w-4xl mx-auto py-8 md:py-12 px-5 sm:px-8">
        <div class="bg-surface-container rounded-2xl p-8 md:p-12 grid md:grid-cols-2 gap-8">
            <div>
                <h2 class="text-xl font-bold mb-3">@GetText("data.title")</h2>
                <p class="text-on-surface-variant leading-relaxed">@GetText("data.text")</p>
            </div>
            <div>
                <h2 class="text-xl font-bold mb-3">@GetText("help.title")</h2>
                <p class="text-on-surface-variant leading-relaxed mb-4">@GetText("help.text")</p>
                <div class="flex flex-wrap gap-4">
                    <a href="mailto:@ExternalLinks.ContactEmail" class="text-secondary font-semibold no-underline inline-flex items-center gap-1">
                        <span class="material-symbols-outlined text-base">mail</span> @GetText("help.email")
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="max-w-4xl mx-auto py-8 md:py-12 px-5 sm:px-8">
        <div class="bg-night rounded-2xl py-10 md:py-14 px-5 sm:px-8 text-center">
            <h2 class="text-2xl font-black text-white mb-4">@GetText("cta.title")</h2>
            <p class="text-white/70 max-w-xl mx-auto mb-8">@GetText("cta.text")</p>
            <button type="button" @onclick="OpenDemoModal" title="@GetShared("cta.demoResetNote")" class="bg-secondary text-white px-8 py-4 rounded-xl font-bold hover:opacity-90 transition-all inline-flex items-center gap-2">
                <span class="material-symbols-outlined" aria-hidden="true">play_circle</span> @GetText("cta.playground")
            </button>
        </div>
    </section>

    <section class="max-w-4xl mx-auto pb-16 px-5 sm:px-8 text-sm">
        <div class="flex flex-wrap gap-6">
            <a href="@AboutHref" class="text-secondary font-semibold no-underline inline-flex items-center gap-1">
                <span class="material-symbols-outlined text-base">groups</span> @GetText("links.about")
            </a>
            <a href="@LicenseHref" class="text-secondary font-semibold no-underline inline-flex items-center gap-1">
                <span class="material-symbols-outlined text-base">gavel</span> @GetText("links.license")
            </a>
        </div>
    </section>
</div>

@code {
    private const string PageKey = "kleine-betriebe";
    private const int PcItemCount = 6;
    private const int ServerItemCount = 3;
    private const string SharedContentKey = "shared";

    private static readonly (string Icon, int Index)[] BenefitItems =
    {
        ("event_available", 0),
        ("person_search", 1),
        ("receipt_long", 2),
    };

    [Parameter] public string? Culture { get; set; }

    [Parameter] public string? Country { get; set; }

    [CascadingParameter(Name = "OpenDemoModal")] public EventCallback OpenDemoModal { get; set; }

    private string ResolvedCulture => SupportedCultures.Resolve(Culture).Code;

    private string CountryKey => string.IsNullOrEmpty(Country) ? LanguageCountries.DefaultCountryFor(ResolvedCulture) : Country;

    private string InstallationHref => CountryPageLinks.Href(Culture, Country, CountryPageLinks.InstallationSlug);

    private string AboutHref => CountryPageLinks.Href(Culture, Country, CountryPageLinks.AboutSlug);

    private string LicenseHref => CountryPageLinks.Href(Culture, Country, CountryPageLinks.LicenseSlug);

    private string GetText(string key) => ContentProvider.GetText(ResolvedCulture, PageKey, key);

    private string GetShared(string key) => ContentProvider.GetText(ResolvedCulture, SharedContentKey, key);
}
