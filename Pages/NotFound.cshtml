@page "/_notfound"
@using Klacks.Marketing.Localization
@using Microsoft.AspNetCore.Diagnostics
@inject IPageContentProvider ContentProvider
@{
    Layout = null;

    // The status code middleware re-executes this page while keeping the original
    // request path in a feature, so the culture is resolved from what the visitor
    // actually typed rather than from "/_notfound".
    var originalPath = HttpContext.Features.Get<IStatusCodeReExecuteFeature>()?.OriginalPath
        ?? HttpContext.Request.Path.Value
        ?? "/";
    var culture = NotFoundPage.ResolveCulture(originalPath);
    var homeHref = NotFoundPage.HomeHref(culture);

    string Sh(string key) => ContentProvider.GetText(culture.Code, "shared", key);
}
<!DOCTYPE html>
<html class="light" lang="@culture.Code" dir="@(culture.IsRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Klacks | @Sh("notFound.title")</title>
    <base href="/" />
    <link rel="icon" href="favicon.ico" sizes="32x32" />
    <link rel="icon" href="images/klacks-logo.svg" type="image/svg+xml" />
    <link href="css/fonts.css" rel="stylesheet" asp-append-version="true" />
    <link href="css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="css/rtl.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="font-['Inter'] bg-background text-on-background selection:bg-secondary-fixed selection:text-on-secondary-fixed">
    <div class="min-h-screen flex flex-col relative overflow-hidden">
        <header class="px-6 pt-6 md:px-10 md:pt-8">
            <div class="inline-flex items-center gap-2">
                <img src="images/klacks-logo.svg" class="w-8 h-8" alt="Klacks Logo" />
                <span class="text-2xl font-black tracking-tighter text-black">Klacks</span>
            </div>
        </header>
        <main class="flex-1 flex items-center justify-center px-6 py-12">
            @* The figure fills the viewport behind the text; at 10% it reads as a
               backdrop rather than competing with the headline. *@
            <img src="images/404-illustration.svg" alt="" class="absolute inset-0 w-full h-full object-contain opacity-10 pointer-events-none select-none" />
            @* min-w-0: flex items default to min-width:auto and would grow past the
               viewport instead of wrapping the headline on narrow screens. *@
            <div class="relative min-w-0 max-w-2xl w-full text-center">
                <div class="inline-block px-3 py-1 bg-surface-container-high rounded-full mb-6">
                    <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@Sh("notFound.badge")</span>
                </div>
                <h1 class="text-[2.5rem] md:text-[3.5rem] leading-[1.1] font-black tracking-tighter text-primary mb-6">@Sh("notFound.title")</h1>
                <p class="text-xl text-on-surface-variant mb-10 leading-relaxed max-w-xl mx-auto">@Sh("notFound.text")</p>
                <a href="@homeHref" class="bg-secondary text-white px-8 py-4 rounded-xl font-bold hover:opacity-90 transition-all no-underline inline-flex items-center gap-2">
                    @Sh("notFound.button") <span class="material-symbols-outlined icon-directional">arrow_forward</span>
                </a>
            </div>
        </main>
    </div>
</body>
</html>
