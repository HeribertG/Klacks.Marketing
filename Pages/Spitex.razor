@page "/spitex"

<PageTitle>Klacks für die Spitex | Tourenplanung &amp; Pflege-Dienstpläne</PageTitle>

<!-- HERO -->
<header class="pt-32 pb-20 px-8 max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-12 gap-16 items-center">
        <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-surface-container-high rounded-full mb-6">
                <span class="material-symbols-outlined text-secondary text-base">home_health</span>
                <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">Für die Spitex &amp; ambulante Pflege</span>
            </div>
            <h1 class="text-[3.5rem] leading-[1.1] font-black tracking-tighter text-primary mb-6">
                Mehr Zeit für Pflege, <span class="text-secondary">weniger für die Tourenplanung.</span>
            </h1>
            <p class="text-xl text-on-surface-variant mb-10 max-w-xl leading-relaxed">
                Klacks plant Einsätze und Touren automatisch &mdash; mit den richtigen Qualifikationen, korrekten Zuschlägen und Feiertagen Ihres Kantons. On-Premise, damit Patientendaten Ihr Haus nie verlassen.
            </p>
            <div class="flex flex-wrap gap-4">
                <a href="/#kontakt" class="bg-secondary text-white px-8 py-4 rounded-xl font-bold hover:opacity-90 transition-all flex items-center gap-2 no-underline">
                    Demo anfragen <span class="material-symbols-outlined">arrow_forward</span>
                </a>
                <a href="/" class="px-8 py-4 rounded-xl font-bold text-primary hover:bg-surface-container-low transition-all no-underline flex items-center gap-2">
                    <span class="material-symbols-outlined">arrow_back</span> Alle Branchen
                </a>
            </div>
        </div>
        <div class="lg:col-span-5 relative hidden lg:block">
            <div class="bg-surface-container-lowest rounded-2xl shadow-2xl p-3 overflow-hidden">
                <div class="flex items-center justify-between mb-3 px-1">
                    <div class="flex gap-2">
                        <div class="w-3 h-3 rounded-full bg-error"></div>
                        <div class="w-3 h-3 rounded-full bg-surface-container-high"></div>
                        <div class="w-3 h-3 rounded-full bg-tertiary-fixed-dim"></div>
                    </div>
                    <div class="text-[0.6875rem] font-bold tracking-[0.05em] text-on-surface-variant uppercase">Timeline</div>
                </div>
                <img src="images/app-timeline-de.png" alt="Klacks Timeline-Ansicht für die Tourenplanung der Spitex" class="w-full h-auto rounded-lg border border-surface-container-high" loading="eager" />
            </div>
        </div>
    </div>
</header>

<!-- HERAUSFORDERUNGEN -->
<section class="bg-surface-container-low py-24 no-line-rule">
    <div class="max-w-7xl mx-auto px-8">
        <div class="text-center mb-16">
            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">Der Alltag in der Spitex</span>
            <h2 class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mt-4">Planung, die jeden Tag anders ist</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-12">
            <div class="flex flex-col items-start">
                <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container-highest mb-6">
                    <span class="material-symbols-outlined text-primary">alt_route</span>
                </div>
                <h3 class="text-xl font-bold text-primary mb-3">Touren statt Schichten</h3>
                <p class="text-on-surface-variant text-sm leading-relaxed">Jede Pflegekraft fährt von Klient zu Klient. Wege, Reihenfolge und Zeitfenster müssen zusammenpassen &mdash; jeden Tag neu.</p>
            </div>
            <div class="flex flex-col items-start">
                <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container-highest mb-6">
                    <span class="material-symbols-outlined text-primary">verified_user</span>
                </div>
                <h3 class="text-xl font-bold text-primary mb-3">Qualifikation entscheidet</h3>
                <p class="text-on-surface-variant text-sm leading-relaxed">Medikamentengabe, Wundversorgung, Diplom-Niveau: Nicht jede Person darf jeden Einsatz übernehmen.</p>
            </div>
            <div class="flex flex-col items-start">
                <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container-highest mb-6">
                    <span class="material-symbols-outlined text-primary">health_and_safety</span>
                </div>
                <h3 class="text-xl font-bold text-primary mb-3">Sensible Daten</h3>
                <p class="text-on-surface-variant text-sm leading-relaxed">Patientendaten gehören geschützt. Eine Cloud-Pflicht ist für viele Organisationen keine Option.</p>
            </div>
        </div>
    </div>
</section>

<!-- LÖSUNG -->
<section class="py-32 px-8 max-w-7xl mx-auto">
    <div class="text-center mb-20">
        <h2 class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mb-4">Wie Klacks die Spitex entlastet</h2>
        <p class="text-on-surface-variant max-w-2xl mx-auto">Von der automatischen Tour bis zum kantonalen Feiertag &mdash; alles greift ineinander.</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all">
            <span class="material-symbols-outlined text-secondary text-3xl mb-6">route</span>
            <h4 class="text-lg font-bold mb-4">Touren automatisch optimiert</h4>
            <p class="text-on-surface-variant text-sm leading-relaxed">Klacks legt Einsatzrouten so, dass Wege kurz und Zeitfenster eingehalten werden &mdash; für Auto, Velo oder zu Fuß.</p>
        </div>
        <div class="p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all">
            <span class="material-symbols-outlined text-secondary text-3xl mb-6">verified</span>
            <h4 class="text-lg font-bold mb-4">Qualifikationen automatisch berücksichtigt</h4>
            <p class="text-on-surface-variant text-sm leading-relaxed">Jeder Einsatz wird nur Personen mit der passenden Qualifikation zugeteilt &mdash; ganz ohne manuelles Prüfen.</p>
        </div>
        <div class="p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all">
            <span class="material-symbols-outlined text-secondary text-3xl mb-6">event_available</span>
            <h4 class="text-lg font-bold mb-4">Zuschläge &amp; Feiertage Ihres Kantons</h4>
            <p class="text-on-surface-variant text-sm leading-relaxed">Nacht-, Wochenend- und Feiertagszuschläge sind vorkonfiguriert &mdash; bis auf Kantons- und Gemeinde-Ebene, frei anpassbar.</p>
        </div>
        <div class="p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all">
            <span class="material-symbols-outlined text-secondary text-3xl mb-6">shield_lock</span>
            <h4 class="text-lg font-bold mb-4">On-Premise: Daten bleiben im Haus</h4>
            <p class="text-on-surface-variant text-sm leading-relaxed">Klacks läuft auf Ihrer eigenen Infrastruktur. Patientendaten verlassen Ihr Haus nicht &mdash; auch nicht zur KI.</p>
        </div>
        <div class="p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all">
            <span class="material-symbols-outlined text-secondary text-3xl mb-6">smart_toy</span>
            <h4 class="text-lg font-bold mb-4">Klacksy plant per Sprache</h4>
            <p class="text-on-surface-variant text-sm leading-relaxed">„Fülle die Touren für morgen" genügt. Bei einem Krankheitsfall schlägt Klacksy sofort verfügbaren Ersatz vor.</p>
        </div>
        <div class="p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all">
            <span class="material-symbols-outlined text-secondary text-3xl mb-6">event_busy</span>
            <h4 class="text-lg font-bold mb-4">Ausfälle schnell aufgefangen</h4>
            <p class="text-on-surface-variant text-sm leading-relaxed">Fällt jemand aus, zeigt Klacks sofort, wer qualifiziert und verfügbar ist &mdash; ohne den ganzen Plan umzuwerfen.</p>
        </div>
    </div>
</section>

<RoutePlanningSection />

<!-- BEISPIEL -->
<section class="bg-surface-container-low py-24 no-line-rule">
    <div class="max-w-3xl mx-auto px-8 text-center">
        <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">Konkret</span>
        <h2 class="text-[1.75rem] md:text-[2rem] font-black tracking-tight mt-4 mb-6">Spitex Genf, zweisprachig, mit Waadtländer Einsätzen</h2>
        <p class="text-on-surface-variant leading-relaxed">
            Französische Oberfläche, Genfer und Waadtländer Feiertage, Spitex-Zuschläge &mdash; in Klacks konfiguriert, nicht nachprogrammiert. Touren werden automatisch optimiert, Qualifikationen geprüft, und Klacksy hilft bei kurzfristigen Änderungen. Patientendaten bleiben dabei vollständig im Haus.
        </p>
    </div>
</section>

<!-- CTA -->
<section class="mx-8 my-24">
    <div class="max-w-7xl mx-auto bg-[#141b2c] rounded-[2rem] py-24 px-8 text-center relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-secondary rounded-full blur-[120px]"></div>
        </div>
        <h2 class="text-[2.5rem] md:text-[3rem] font-black text-white tracking-tighter mb-6 relative z-10">Klacks in Ihrer Spitex erleben</h2>
        <p class="text-white/70 max-w-xl mx-auto mb-10 relative z-10">Wir zeigen Ihnen in einer persönlichen Demo, wie Klacks Touren, Qualifikationen und Zuschläge für Ihre Organisation übernimmt.</p>
        <div class="flex flex-wrap justify-center gap-6 relative z-10">
            <a href="/#kontakt" class="bg-secondary text-white px-10 py-5 rounded-2xl font-black text-lg hover:scale-105 transition-transform no-underline flex items-center gap-3">
                <span class="material-symbols-outlined">calendar_month</span> Demo anfragen
            </a>
        </div>
    </div>
</section>
