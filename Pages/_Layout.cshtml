<!DOCTYPE html>
<html class="light" lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Klacks ist die Open-Source-Plattform für Personaleinsatzplanung in Schicht- und Einsatzbetrieben: Dienste automatisch planen, Touren optimieren, per KI-Assistent steuern — On-Premise und mit freier Wahl des KI-Modells. Für Spitex, Spitäler, Security, Reinigung und Logistik." />
    <meta name="keywords" content="Personaleinsatzplanung, Dienstplanung, Schichtplanung, Einsatzplanung, Tourenplanung, Spitex Software, Spitalplanung, Sicherheitsdienst Planung, KI-Assistent, On-Premise, Open Source" />
    <meta property="og:title" content="Klacks – Personaleinsatzplanung, die Ihnen gehört" />
    <meta property="og:description" content="Dienste automatisch planen, Touren optimieren, per KI-Assistent steuern — On-Premise und Open Source. Sie behalten die Kontrolle über Daten, KI und Regeln." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content="Klacks" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- TODO: og:url + og:image (1200x630 PNG-Banner) ergaenzen, sobald Domain steht. SVG wird von Social-Crawlern nicht als og:image gerendert. -->
    <title>Klacks | Personaleinsatzplanung, die Ihnen gehört</title>
    <base href="/" />
    <link rel="icon" href="images/klacks-logo.svg" type="image/svg+xml" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body class="font-['Inter'] bg-background text-on-background selection:bg-secondary-fixed selection:text-on-secondary-fixed">
    @RenderBody()

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled error has occurred. See browser console for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">X</a>
    </div>

    <script src="~/_framework/blazor.server.js"></script>
</body>
</html>
