@page "/vorschau-grosse-betriebe"
@inject IPageContentProvider ContentProvider

@* Hidden German-only preview of the target page for large companies (250 employees and more; buying motive:
   cost). Cost is argued only through the licence structure - no savings percentages, no staff savings - and the
   running costs (servers, operation, AI model) are named. Every enterprise feature listed here is backed by the
   code of Klacks.Api (sources in the preview report of 2026-10-03); unverified ones (SAML, multi-tenancy, a
   documented public API, support contracts) are deliberately left out. noindex, not in the sitemap, not linked
   from navigation or footer; other cultures have no route. *@
<PreviewHead Title="@Tx("pageTitle")" Description="@Tx("metaDescription")" />

<div class="preview-page">
    <header id="branchen" class="pt-20 md:pt-28 pb-12 md:pb-16 px-4 sm:px-8 max-w-4xl mx-auto text-center">
        <span class="inline-flex items-center gap-2 px-3 py-1 bg-surface-container-high rounded-full text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">
            <span class="material-symbols-outlined text-secondary text-base" aria-hidden="true">domain</span>@Tx("hero.badge")
        </span>
        <h1 class="text-[2.125rem] md:text-[3rem] leading-[1.1] font-black tracking-tighter text-primary mt-6 mb-6 hyphens-auto break-words">@Tx("hero.title")</h1>
        <p class="text-lg md:text-xl text-on-surface-variant leading-relaxed mb-8">@Tx("hero.subtitle")</p>
        <div class="flex flex-wrap justify-center gap-4">
            <button type="button" @onclick="OpenDemoModal" title="@Sh("cta.demoResetNote")" class="btn-shine bg-secondary text-white px-7 py-4 rounded-xl font-bold hover:opacity-90 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined" aria-hidden="true">play_circle</span> @Tx("hero.playground")
            </button>
            <a href="@ExternalLinks.GithubUrl" target="_blank" class="px-7 py-4 rounded-xl font-bold text-primary bg-surface-container-low hover:bg-surface-container-high transition-all no-underline flex items-center gap-2">
                <span class="material-symbols-outlined" aria-hidden="true">code</span> @Tx("hero.source")
            </a>
        </div>
    </header>

    <section id="kontrolle" class="reveal bg-surface-container-low py-14 md:py-20 no-line-rule" aria-labelledby="costs-heading">
        <div class="max-w-5xl mx-auto px-4 sm:px-8">
            <div class="text-center mb-10">
                <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@Tx("costs.eyebrow")</span>
                <h2 id="costs-heading" class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mt-4">@Tx("costs.title")</h2>
            </div>
            <div class="grid md:grid-cols-2 gap-5">
                <div class="rounded-2xl bg-surface-container-lowest p-6">
                    <h3 class="text-lg font-black mt-0 mb-4">@Tx("costs.none.title")</h3>
                    <ul class="space-y-3 list-none p-0 m-0">
                        @for (var index = 0; index < NoCostItemCount; index++)
                        {
                            <li class="flex gap-2 text-sm text-on-surface-variant"><span class="material-symbols-outlined text-secondary text-base" aria-hidden="true">block</span>@Tx($"costs.none.items.{index}")</li>
                        }
                    </ul>
                </div>
                <div class="rounded-2xl bg-surface-container-lowest p-6">
                    <h3 class="text-lg font-black mt-0 mb-4">@Tx("costs.paid.title")</h3>
                    <ul class="space-y-3 list-none p-0 m-0">
                        @for (var index = 0; index < PaidItemCount; index++)
                        {
                            <li class="flex gap-2 text-sm text-on-surface-variant"><span class="material-symbols-outlined text-primary text-base" aria-hidden="true">payments</span>@Tx($"costs.paid.items.{index}")</li>
                        }
                    </ul>
                </div>
            </div>
            <p class="text-sm text-on-surface-variant text-center max-w-2xl mx-auto mt-6 mb-0">@Tx("costs.note")</p>
        </div>
    </section>

    <section id="regeln" class="reveal py-14 md:py-20 px-4 sm:px-8 max-w-7xl mx-auto no-line-rule" aria-labelledby="features-heading">
        <div class="text-center mb-10">
            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@Tx("features.eyebrow")</span>
            <h2 id="features-heading" class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mt-4">@Tx("features.title")</h2>
        </div>
        <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 list-none p-0 m-0">
            @foreach (var feature in Features)
            {
                <li class="rounded-2xl bg-surface-container-low p-6">
                    <span class="material-symbols-outlined text-secondary text-2xl" aria-hidden="true">@feature.Icon</span>
                    <h3 class="text-base font-bold mt-3 mb-2">@Tx($"features.{feature.Key}.title")</h3>
                    <p class="text-sm text-on-surface-variant leading-relaxed m-0">@Tx($"features.{feature.Key}.text")</p>
                </li>
            }
        </ul>
    </section>

    <section id="ki-agenten" class="reveal bg-surface-container-low py-14 md:py-20 no-line-rule scroll-mt-24" aria-labelledby="agents-heading">
        <div class="max-w-5xl mx-auto px-4 sm:px-8">
            <div class="text-center max-w-3xl mx-auto mb-10">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-secondary-container px-3 py-1 text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-secondary-container">
                    <span class="material-symbols-outlined text-sm" aria-hidden="true">hub</span>@Tx("agents.eyebrow")
                </span>
                <h2 id="agents-heading" class="text-[1.75rem] md:text-[2.25rem] font-black tracking-tight mt-4 mb-4">@Tx("agents.title")</h2>
                <p class="text-on-surface-variant leading-relaxed m-0">@Tx("agents.text")</p>
            </div>
            <h3 class="text-center text-xl font-black mt-0 mb-6">@Tx("agents.stepsTitle")</h3>
            <ol class="grid md:grid-cols-3 gap-5 list-none p-0 m-0">
                @for (var index = 0; index < AgentStepCount; index++)
                {
                    <li class="rounded-2xl bg-surface-container-lowest p-6">
                        <span class="flex items-center gap-2 font-bold text-primary mb-2">
                            <span class="w-7 h-7 rounded-full bg-secondary text-white text-sm flex items-center justify-center" aria-hidden="true">@(index + 1)</span>@Tx($"agents.steps.{index}.title")
                        </span>
                        <span class="block text-sm text-on-surface-variant leading-relaxed break-words">@Tx($"agents.steps.{index}.text")</span>
                    </li>
                }
            </ol>
            <h3 class="text-lg font-black mt-10 mb-4">@Tx("agents.detailsTitle")</h3>
            <ul class="grid md:grid-cols-3 gap-4 list-none p-0 m-0">
                @for (var index = 0; index < AgentItemCount; index++)
                {
                    <li class="flex gap-3 rounded-2xl bg-surface-container-lowest p-5 text-sm text-on-surface-variant leading-relaxed"><span class="material-symbols-outlined text-secondary text-xl" aria-hidden="true">hub</span><span>@Tx($"agents.items.{index}")</span></li>
                }
            </ul>
        </div>
    </section>

    <section class="reveal py-14 md:py-20 no-line-rule" aria-labelledby="requirements-heading">
        <div class="max-w-3xl mx-auto px-4 sm:px-8">
            <div class="text-center mb-8">
                <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@Tx("requirements.eyebrow")</span>
                <h2 id="requirements-heading" class="text-[1.75rem] md:text-[2.25rem] font-black tracking-tight mt-4 mb-0">@Tx("requirements.title")</h2>
            </div>
            <ul class="space-y-4 list-none p-0 m-0">
                @for (var index = 0; index < RequirementItemCount; index++)
                {
                    <li class="flex gap-3 text-on-surface-variant leading-relaxed"><span class="material-symbols-outlined text-secondary text-xl" aria-hidden="true">info</span><span>@Tx($"requirements.items.{index}")</span></li>
                }
            </ul>
            <p class="mt-6 mb-0 text-sm"><a href="@InstallationHref" class="font-bold text-secondary no-underline inline-flex items-center gap-1"><span class="material-symbols-outlined text-base" aria-hidden="true">install_desktop</span> @Sh("nav.download")</a></p>
        </div>
    </section>

    <section id="klacksy" class="reveal py-14 md:py-20 px-4 sm:px-8 max-w-3xl mx-auto text-center no-line-rule" aria-labelledby="klacksy-heading">
        <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@Tx("klacksy.eyebrow")</span>
        <h2 id="klacksy-heading" class="text-[1.75rem] md:text-[2.25rem] font-black tracking-tight mt-4 mb-4">@Tx("klacksy.title")</h2>
        <p class="text-on-surface-variant leading-relaxed m-0">@Tx("klacksy.text")</p>
    </section>

    <section id="download" class="reveal pb-14 md:pb-20 px-4 sm:px-8 max-w-4xl mx-auto no-line-rule" aria-labelledby="cta-heading">
        <div class="bg-night rounded-2xl py-10 md:py-14 px-6 md:px-8 text-center">
            <h2 id="cta-heading" class="text-2xl md:text-3xl font-black text-white mt-0 mb-4">@Tx("cta.title")</h2>
            <p class="text-white/70 max-w-xl mx-auto mb-8">@Tx("cta.text")</p>
            <div class="flex flex-wrap justify-center gap-4">
                <button type="button" @onclick="OpenDemoModal" title="@Sh("cta.demoResetNote")" class="bg-secondary text-white px-7 py-4 rounded-xl font-bold hover:opacity-90 transition-all inline-flex items-center gap-2">
                    <span class="material-symbols-outlined" aria-hidden="true">play_circle</span> @Tx("hero.playground")
                </button>
                <a href="mailto:@ExternalLinks.ContactEmail" class="border border-white/30 text-white px-7 py-4 rounded-xl font-bold hover:bg-white/10 transition-all no-underline inline-flex items-center gap-2">
                    <span class="material-symbols-outlined" aria-hidden="true">mail</span> @Tx("cta.contact")
                </a>
            </div>
        </div>
        <div class="flex flex-wrap justify-center gap-6 mt-8 text-sm">
            <a href="@StartPreviewRoute" class="font-bold text-secondary no-underline inline-flex items-center gap-1"><span class="material-symbols-outlined text-base icon-directional" aria-hidden="true">arrow_back</span> @Tx("links.start")</a>
            <a href="@MidPreviewRoute" class="font-bold text-secondary no-underline inline-flex items-center gap-1">@Tx("links.mid") <span class="material-symbols-outlined text-base icon-directional" aria-hidden="true">arrow_forward</span></a>
        </div>
    </section>

    <PreviewMobilePlaygroundButton Label="@Tx("mobileButton")" />
</div>

@code {
    private const string PageKey = "vorschau-grosse-betriebe";
    private const string SharedContentKey = "shared";
    private const string Culture = SupportedCultures.DefaultCode;
    private const string CountryKey = CountryIndustries.SwissCountryPageKey;
    private const string StartPreviewRoute = "/vorschau-start";
    private const string MidPreviewRoute = "/vorschau-mittlere-betriebe";
    private const int NoCostItemCount = 3;
    private const int PaidItemCount = 4;
    private const int RequirementItemCount = 4;
    private const int AgentItemCount = 3;
    private const int AgentStepCount = 3;

    private static readonly (string Icon, string Key)[] Features =
    {
        ("admin_panel_settings", "roles"),
        ("visibility", "visibility"),
        ("badge", "identity"),
        ("receipt_long", "payroll"),
        ("upload_file", "import"),
        ("history", "audit"),
        ("task_alt", "approval"),
        ("system_update", "updates"),
        ("database", "scale"),
    };

    [CascadingParameter(Name = "OpenDemoModal")] public EventCallback OpenDemoModal { get; set; }

    private string InstallationHref => CountryPageLinks.Href(null, CountryKey, CountryPageLinks.InstallationSlug);

    private string Tx(string key) => ContentProvider.GetText(Culture, PageKey, key);

    private string Sh(string key) => ContentProvider.GetText(Culture, SharedContentKey, key);
}
