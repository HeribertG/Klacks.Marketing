@page "/{country}/datenschutz"
@page "/{culture}/{country}/datenschutz"
@inject IPageContentProvider ContentProvider

<PageTitle>Klacks | @Lx("privacy.title")</PageTitle>
<SeoHead PageKey="datenschutz" Culture="@ResolvedCulture" SameForEveryCountry="true" Title="@($"Klacks | {Lx("privacy.title")}")" DescriptionSource="@Lx("privacy.contentHtml")" />

<header class="pt-32 pb-16 px-8 max-w-3xl mx-auto">
    <h1 class="text-[2.5rem] font-black tracking-tight text-primary mb-10">@Lx("privacy.title")</h1>
    <div class="legal-prose">@LxHtml("privacy.contentHtml")</div>
</header>

@code {
    [Parameter] public string? Culture { get; set; }

    // Present so the route binds; the policy describes this website as a whole and
    // does not vary by country.
    [Parameter] public string? Country { get; set; }

    private string ResolvedCulture => SupportedCultures.Resolve(Culture).Code;

    private string Lx(string key) => ContentProvider.GetText(ResolvedCulture, "legal", key);

    private MarkupString LxHtml(string key) => (MarkupString)Lx(key);
}
