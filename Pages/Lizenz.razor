@page "/{country}/lizenz"
@page "/{culture}/{country}/lizenz"
@inject IPageContentProvider ContentProvider

<PageTitle>@GetText("pageTitle")</PageTitle>
<SeoHead PageKey="@PageKey" Culture="@ResolvedCulture" SameForEveryCountry="true" Title="@GetText("pageTitle")" DescriptionSource="@MetaDescriptionSource.Resolve(ContentProvider, ResolvedCulture, PageKey, MetaDescriptionSource.MetaDescriptionSuffix, "hero.subtitle")" />

<div class="min-h-screen bg-surface text-on-surface">
    <section class="max-w-5xl mx-auto pt-14 md:pt-24 pb-10 md:pb-16 px-5 sm:px-8 text-center">
        <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-6">
            @GetText("hero.title")
        </h1>
        <p class="text-xl text-on-surface-variant max-w-3xl mx-auto leading-relaxed">
            @((MarkupString)GetText("hero.subtitle"))
        </p>
    </section>

    <section class="max-w-4xl mx-auto py-8 md:py-12 px-5 sm:px-8">
        <h2 class="text-2xl font-bold mb-8">@GetText("agpl.title")</h2>
        <div class="grid md:grid-cols-3 gap-6">
            @foreach (var (icon, index) in AgplItems)
            {
                <div class="bg-surface-container rounded-xl p-6">
                    <span class="material-symbols-outlined text-secondary text-2xl mb-3">@icon</span>
                    <h3 class="font-bold mb-2">@GetText($"agpl.items.{index}.title")</h3>
                    <p class="text-sm text-on-surface-variant">@GetText($"agpl.items.{index}.text")</p>
                </div>
            }
        </div>
    </section>

    <section class="max-w-4xl mx-auto py-8 md:py-12 px-5 sm:px-8">
        <h2 class="text-2xl font-bold mb-8">@GetText("commercial.title")</h2>
        <div class="grid md:grid-cols-3 gap-6">
            @foreach (var (icon, index) in CommercialItems)
            {
                <div class="bg-surface-container rounded-xl p-6">
                    <span class="material-symbols-outlined text-secondary text-2xl mb-3">@icon</span>
                    <h3 class="font-bold mb-2">@GetText($"commercial.items.{index}.title")</h3>
                    <p class="text-sm text-on-surface-variant">@GetText($"commercial.items.{index}.text")</p>
                </div>
            }
        </div>
    </section>

    <section class="max-w-4xl mx-auto py-8 md:py-12 px-5 sm:px-8">
        <div class="bg-surface-container rounded-2xl p-8 md:p-12 grid md:grid-cols-2 gap-8">
            <div>
                <h2 class="text-xl font-bold mb-3">@GetText("offer.title")</h2>
                <p class="text-on-surface-variant leading-relaxed">@GetText("offer.text")</p>
            </div>
            <div>
                <h2 class="text-xl font-bold mb-3">@GetText("why.title")</h2>
                <p class="text-on-surface-variant leading-relaxed">@GetText("why.text")</p>
            </div>
        </div>
    </section>

    <section class="max-w-4xl mx-auto py-8 md:py-12 px-5 sm:px-8">
        <div class="bg-night rounded-2xl py-10 md:py-14 px-5 sm:px-8 text-center">
            <h2 class="text-2xl font-black text-white mb-4">@GetText("cta.title")</h2>
            <p class="text-white/70 max-w-xl mx-auto mb-6">@GetText("cta.text")</p>
            <div class="text-white/70 max-w-md mx-auto mb-8 text-left text-sm">
                <p class="font-bold text-white mb-2">@GetText("cta.includeTitle")</p>
                @((MarkupString)GetText("cta.includeHtml"))
            </div>
            <div class="flex flex-wrap justify-center gap-4 items-center">
                <a href="mailto:@ExternalLinks.ContactEmail" class="bg-secondary text-white px-8 py-4 rounded-xl font-bold hover:opacity-90 transition-all no-underline inline-flex items-center gap-2">
                    <span class="material-symbols-outlined">mail</span> @GetText("cta.button")
                </a>
                <span class="text-white font-mono select-all">@ExternalLinks.ContactEmail</span>
            </div>
        </div>
    </section>

    <section class="max-w-4xl mx-auto pb-16 px-5 sm:px-8 text-sm text-on-surface-variant">
        <p class="mb-4">@GetText("note")</p>
        <div class="flex flex-wrap gap-6">
            <a href="@ExternalLinks.AgplLicenseUrl" target="_blank" class="text-secondary font-semibold no-underline inline-flex items-center gap-1">
                <span class="material-symbols-outlined text-base">gavel</span> @GetText("links.agplText")
            </a>
            <a href="@ExternalLinks.GithubUrl" target="_blank" class="text-secondary font-semibold no-underline inline-flex items-center gap-1">
                <span class="material-symbols-outlined text-base">code</span> @GetText("links.github")
            </a>
        </div>
    </section>
</div>

@code {
    private const string PageKey = "lizenz";

    private static readonly (string Icon, int Index)[] AgplItems =
    {
        ("apartment", 0),
        ("edit_note", 1),
        ("support_agent", 2),
    };

    private static readonly (string Icon, int Index)[] CommercialItems =
    {
        ("inventory_2", 0),
        ("lock", 1),
        ("policy", 2),
    };

    [Parameter] public string? Culture { get; set; }

    // Present so the route binds; the license terms are company-wide and do not
    // vary by country.
    [Parameter] public string? Country { get; set; }

    private string ResolvedCulture => SupportedCultures.Resolve(Culture).Code;

    private string GetText(string key) => ContentProvider.GetText(ResolvedCulture, PageKey, key);
}
