@page "/logistik"

<PageTitle>Klacks für Logistik | Touren, Lenkzeiten &amp; grenzüberschreitend</PageTitle>

<!-- HERO -->
<header class="pt-32 pb-20 px-8 max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-12 gap-16 items-center">
        <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-surface-container-high rounded-full mb-6">
                <span class="material-symbols-outlined text-secondary text-base">local_shipping</span>
                <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">Für Logistik &amp; Transport</span>
            </div>
            <h1 class="text-[3.5rem] leading-[1.1] font-black tracking-tighter text-primary mb-6">
                Touren, Lenkzeiten, Termine — <span class="text-secondary">alles im Griff.</span>
            </h1>
            <p class="text-xl text-on-surface-variant mb-10 max-w-xl leading-relaxed">
                Klacks plant Touren und Fahrer — mit Lenk- und Ruhezeiten, passenden Führerschein-Klassen und grenzüberschreitenden Feiertagen. Routen werden automatisch optimiert.
            </p>
            <div class="flex flex-wrap gap-4">
                <a href="/#kontakt" class="bg-secondary text-white px-8 py-4 rounded-xl font-bold hover:opacity-90 transition-all flex items-center gap-2 no-underline">Demo anfragen <span class="material-symbols-outlined">arrow_forward</span></a>
                <a href="/" class="px-8 py-4 rounded-xl font-bold text-primary hover:bg-surface-container-low transition-all no-underline flex items-center gap-2"><span class="material-symbols-outlined">arrow_back</span> Alle Branchen</a>
            </div>
        </div>
        <div class="lg:col-span-5 relative hidden lg:block">
            <div class="bg-surface-container-lowest rounded-2xl shadow-2xl p-3 overflow-hidden">
                <div class="flex items-center justify-between mb-3 px-1">
                    <div class="flex gap-2"><div class="w-3 h-3 rounded-full bg-error"></div><div class="w-3 h-3 rounded-full bg-surface-container-high"></div><div class="w-3 h-3 rounded-full bg-tertiary-fixed-dim"></div></div>
                    <div class="text-[0.6875rem] font-bold tracking-[0.05em] text-on-surface-variant uppercase">Timeline</div>
                </div>
                <img src="images/app-timeline-de.png" alt="Klacks Timeline-Ansicht für Touren und Fahrereinsätze" class="w-full h-auto rounded-lg border border-surface-container-high" loading="eager" />
            </div>
        </div>
    </div>
</header>

<!-- HERAUSFORDERUNGEN -->
<section class="bg-surface-container-low py-24 no-line-rule">
    <div class="max-w-7xl mx-auto px-8">
        <div class="text-center mb-16">
            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">Der Logistik-Alltag</span>
            <h2 class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mt-4">Touren, Recht und Termine zugleich</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-12">
            <div class="flex flex-col items-start"><div class="w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container-highest mb-6"><span class="material-symbols-outlined text-primary">alt_route</span></div><h3 class="text-xl font-bold text-primary mb-3">Touren &amp; Termine</h3><p class="text-on-surface-variant text-sm leading-relaxed">Stopps, Zeitfenster und Wege müssen zusammenpassen — jede Umplanung zieht Folgen nach sich.</p></div>
            <div class="flex flex-col items-start"><div class="w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container-highest mb-6"><span class="material-symbols-outlined text-primary">timer</span></div><h3 class="text-xl font-bold text-primary mb-3">Lenk- &amp; Ruhezeiten</h3><p class="text-on-surface-variant text-sm leading-relaxed">Gesetzliche Lenk- und Ruhezeiten sind Pflicht — und von Hand über viele Fahrer kaum sicher einzuhalten.</p></div>
            <div class="flex flex-col items-start"><div class="w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container-highest mb-6"><span class="material-symbols-outlined text-primary">public</span></div><h3 class="text-xl font-bold text-primary mb-3">Grenzüberschreitend</h3><p class="text-on-surface-variant text-sm leading-relaxed">Verschiedene Länder, verschiedene Feiertage und Regeln: Eine Tour über die Grenze braucht beide Kalender.</p></div>
        </div>
    </div>
</section>

<!-- LÖSUNG -->
<section class="py-32 px-8 max-w-7xl mx-auto">
    <div class="text-center mb-20">
        <h2 class="text-[2rem] md:text-[2.5rem] font-black tracking-tight mb-4">Wie Klacks die Logistik entlastet</h2>
        <p class="text-on-surface-variant max-w-2xl mx-auto">Von der optimierten Tour bis zum grenzüberschreitenden Feiertag — alles greift ineinander.</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all"><span class="material-symbols-outlined text-secondary text-3xl mb-6">route</span><h4 class="text-lg font-bold mb-4">Touren automatisch optimiert</h4><p class="text-on-surface-variant text-sm leading-relaxed">Klacks legt Stopps in die sinnvollste Reihenfolge — kurze Wege, eingehaltene Zeitfenster, weniger Leerfahrten.</p></div>
        <div class="p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all"><span class="material-symbols-outlined text-secondary text-3xl mb-6">timer</span><h4 class="text-lg font-bold mb-4">Lenk- &amp; Ruhezeiten geprüft</h4><p class="text-on-surface-variant text-sm leading-relaxed">Gesetzliche Grenzen werden in Echtzeit überwacht — Verstöße entstehen gar nicht erst.</p></div>
        <div class="p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all"><span class="material-symbols-outlined text-secondary text-3xl mb-6">flag</span><h4 class="text-lg font-bold mb-4">Mehrere Länder &amp; Kalender</h4><p class="text-on-surface-variant text-sm leading-relaxed">Feiertage und Regeln mehrerer Länder lassen sich mischen — jeder mit eigener Wirkung auf Zeiten und Zuschläge.</p></div>
        <div class="p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all"><span class="material-symbols-outlined text-secondary text-3xl mb-6">badge</span><h4 class="text-lg font-bold mb-4">Führerschein-Klassen passend</h4><p class="text-on-surface-variant text-sm leading-relaxed">Klacks teilt Touren nur Fahrern mit der passenden Berechtigung zu — und warnt vor ablaufenden Nachweisen.</p></div>
        <div class="p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all"><span class="material-symbols-outlined text-secondary text-3xl mb-6">smart_toy</span><h4 class="text-lg font-bold mb-4">Klacksy plant per Sprache</h4><p class="text-on-surface-variant text-sm leading-relaxed">„Plane die Touren für morgen, Fahrer Meier ist krank" genügt — Klacksy rechnet alles neu.</p></div>
        <div class="p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all"><span class="material-symbols-outlined text-secondary text-3xl mb-6">event_busy</span><h4 class="text-lg font-bold mb-4">Ausfälle schnell aufgefangen</h4><p class="text-on-surface-variant text-sm leading-relaxed">Fällt ein Fahrer aus, zeigt Klacks sofort, wer qualifiziert, verfügbar und in der Lenkzeit ist.</p></div>
    </div>
</section>

<RoutePlanningSection />

<!-- CTA -->
<section class="mx-8 my-24">
    <div class="max-w-7xl mx-auto bg-[#141b2c] rounded-[2rem] py-24 px-8 text-center relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none"><div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-secondary rounded-full blur-[120px]"></div></div>
        <h2 class="text-[2.5rem] md:text-[3rem] font-black text-white tracking-tighter mb-6 relative z-10">Klacks in Ihrem Logistikbetrieb erleben</h2>
        <p class="text-white/70 max-w-xl mx-auto mb-10 relative z-10">In einer persönlichen Demo zeigen wir, wie Klacks Touren, Lenkzeiten und Fahrer für Sie übernimmt.</p>
        <div class="flex flex-wrap justify-center gap-6 relative z-10"><a href="/#kontakt" class="bg-secondary text-white px-10 py-5 rounded-2xl font-black text-lg hover:scale-105 transition-transform no-underline flex items-center gap-3"><span class="material-symbols-outlined">calendar_month</span> Demo anfragen</a></div>
    </div>
</section>
