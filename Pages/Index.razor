@page "/"
@page "/{culture}"
@inject IPageContentProvider ContentProvider

<PageTitle>@Ix("pageTitle")</PageTitle>
<SeoHead PageKey="" Culture="@ResolvedCulture" />

<!-- HERO SECTION -->
<header class="pt-32 pb-20 px-8 max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-12 gap-16 items-center">
        <div class="lg:col-span-7">
            <div class="hero-enter hero-enter-1 inline-block px-3 py-1 bg-surface-container-high rounded-full mb-6">
                <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@IxHtml("hero.badge")</span>
            </div>
            <h1 class="hero-enter hero-enter-2 text-[3.5rem] leading-[1.1] font-black tracking-tighter text-primary mb-6">
                @IxHtml("hero.titleHtml")
            </h1>
            <p class="hero-enter hero-enter-3 text-xl text-on-surface-variant mb-10 max-w-xl leading-relaxed">
                @IxHtml("hero.subtitle")
            </p>
            <div class="hero-enter hero-enter-4 flex flex-wrap gap-4 mb-10">
                <a href="#kontakt" class="bg-secondary text-white px-8 py-4 rounded-xl font-bold hover:opacity-90 transition-all flex items-center gap-2 no-underline">
                    @Sh("nav.demoRequest") <span class="material-symbols-outlined icon-directional">arrow_forward</span>
                </a>
                <a href="https://github.com/HeribertG/Klacks" target="_blank" class="px-8 py-4 rounded-xl font-bold text-primary hover:bg-surface-container-low transition-all no-underline flex items-center gap-2">
                    <span class="material-symbols-outlined">code</span> @Sh("nav.github")
                </a>
            </div>
            <div class="hero-enter hero-enter-5 flex flex-wrap gap-x-6 gap-y-3">
                <span class="inline-flex items-center gap-2 text-sm font-semibold text-on-surface-variant"><span class="material-symbols-outlined text-secondary text-base">shield_lock</span> @IxHtml("hero.trust1")</span>
                <span class="inline-flex items-center gap-2 text-sm font-semibold text-on-surface-variant"><span class="material-symbols-outlined text-secondary text-base">smart_toy</span> @IxHtml("hero.trust2")</span>
                <span class="inline-flex items-center gap-2 text-sm font-semibold text-on-surface-variant"><span class="material-symbols-outlined text-secondary text-base">public</span> @IxHtml("hero.trust3")</span>
                <span class="inline-flex items-center gap-2 text-sm font-semibold text-on-surface-variant"><span class="material-symbols-outlined text-secondary text-base">code</span> @IxHtml("hero.trust4")</span>
            </div>
        </div>
        <div class="hero-enter hero-enter-3 lg:col-span-5 relative hidden lg:block">
            <div class="bg-surface-container-lowest rounded-2xl shadow-2xl p-3 overflow-hidden">
                <div class="flex items-center justify-between mb-3 px-1">
                    <div class="flex gap-2">
                        <div class="w-3 h-3 rounded-full bg-error"></div>
                        <div class="w-3 h-3 rounded-full bg-surface-container-high"></div>
                        <div class="w-3 h-3 rounded-full bg-tertiary-fixed-dim"></div>
                    </div>
                    <div class="text-[0.6875rem] font-bold tracking-[0.05em] text-on-surface-variant uppercase">@Ix("hero.screenshotLabel")</div>
                </div>
                <img src="images/app-schedule-de.png" alt="@Ix("hero.screenshotAlt")" class="w-full h-auto rounded-lg border border-surface-container-high" loading="eager" />
                @if (!string.IsNullOrEmpty(Ix("hero.screenshotCaption")))
                {
                    <p class="text-xs text-on-surface-variant mt-3 px-1 mb-0">@Ix("hero.screenshotCaption")</p>
                }
            </div>
        </div>
    </div>
</header>

<!-- PAIN POINTS -->
<section class="reveal bg-surface-container-low py-24 no-line-rule">
    <div class="max-w-7xl mx-auto px-8">
        <div class="reveal-stagger grid md:grid-cols-3 gap-12">
            <div class="flex flex-col items-start">
                <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container-highest mb-6">
                    <span class="material-symbols-outlined text-primary">schedule</span>
                </div>
                <h3 class="text-xl font-bold text-primary mb-3">@IxHtml("painPoints.item1.title")</h3>
                <p class="text-on-surface-variant text-sm leading-relaxed">@IxHtml("painPoints.item1.text")</p>
            </div>
            <div class="flex flex-col items-start">
                <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container-highest mb-6">
                    <span class="material-symbols-outlined text-primary">gavel</span>
                </div>
                <h3 class="text-xl font-bold text-primary mb-3">@IxHtml("painPoints.item2.title")</h3>
                <p class="text-on-surface-variant text-sm leading-relaxed">@IxHtml("painPoints.item2.text")</p>
            </div>
            <div class="flex flex-col items-start">
                <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-surface-container-highest mb-6">
                    <span class="material-symbols-outlined text-primary">cloud_off</span>
                </div>
                <h3 class="text-xl font-bold text-primary mb-3">@IxHtml("painPoints.item3.title")</h3>
                <p class="text-on-surface-variant text-sm leading-relaxed">@IxHtml("painPoints.item3.text")</p>
            </div>
        </div>
    </div>
</section>

<!-- USP STACK: SIE BEHALTEN DIE KONTROLLE -->
<section class="reveal py-32 px-8 max-w-7xl mx-auto" id="kontrolle">
    <div class="mb-20 text-center">
        <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant">@Ix("usp.eyebrow")</span>
        <h2 class="text-[2.5rem] font-black tracking-tight mt-4 mb-4">@Ix("usp.title")</h2>
        <p class="text-on-surface-variant max-w-2xl mx-auto">@Ix("usp.subtitle")</p>
        <div class="w-16 h-1 bg-secondary mx-auto rounded-full mt-6"></div>
    </div>
    <div class="reveal-stagger grid md:grid-cols-3 gap-8">
        <div class="card-hover p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all">
            <span class="material-symbols-outlined text-secondary text-3xl mb-6">shield_lock</span>
            <p class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant mb-2">@Ix("usp.data.label")</p>
            <h4 class="text-lg font-bold mb-4">@IxHtml("usp.data.title")</h4>
            <p class="text-on-surface-variant text-sm leading-relaxed">@IxHtml("usp.data.text")</p>
        </div>
        <div class="p-8 bg-tertiary-container text-white rounded-2xl shadow-xl transform md:scale-105 relative z-10">
            <span class="material-symbols-outlined text-tertiary-fixed text-3xl mb-6">smart_toy</span>
            <p class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-tertiary-fixed mb-2">@Ix("usp.ai.label")</p>
            <h4 class="text-lg font-bold mb-4">@IxHtml("usp.ai.titleHtml")</h4>
            <p class="text-tertiary-fixed text-sm leading-relaxed">@IxHtml("usp.ai.text")</p>
        </div>
        <div class="card-hover p-8 bg-surface-container-lowest rounded-2xl group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all">
            <span class="material-symbols-outlined text-secondary text-3xl mb-6">tune</span>
            <p class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-on-surface-variant mb-2">@Ix("usp.rules.label")</p>
            <h4 class="text-lg font-bold mb-4">@IxHtml("usp.rules.title")</h4>
            <p class="text-on-surface-variant text-sm leading-relaxed">@IxHtml("usp.rules.text")</p>
        </div>
    </div>
</section>

<!-- KI + DATENHOHEIT SYNERGIE -->
<section class="reveal mx-8 mb-32">
    <div class="max-w-5xl mx-auto bg-[#141b2c] rounded-[2rem] py-16 px-8 md:px-16 text-center relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none">
            <div class="blob-animate absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-secondary rounded-full blur-[120px]"></div>
        </div>
        <div class="relative z-10">
            <span class="text-[0.6875rem] font-bold tracking-[0.05em] uppercase text-tertiary-fixed">@Ix("aiSynergy.eyebrow")</span>
            <h2 class="text-[2rem] md:text-[2.5rem] font-black text-white tracking-tighter mt-4 mb-6">@IxHtml("aiSynergy.titleHtml")</h2>
            <p class="text-white/70 max-w-2xl mx-auto leading-relaxed">@IxHtml("aiSynergy.textHtml")</p>
        </div>
    </div>
</section>

