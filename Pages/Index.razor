            <span class="text-xs font-bold text-secondary inline-flex items-center gap-1 mt-auto">@Ix("industries.moreLabel") <span class="material-symbols-outlined text-sm icon-directional">arrow_forward</span></span>
        </a>
        <a href="@IndustryHref("hausdienste")" class="card-hover p-6 bg-surface-container-lowest rounded-2xl flex flex-col items-start group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all no-underline">
            <span class="material-symbols-outlined text-secondary text-3xl mb-4">cleaning_services</span>
            <h4 class="text-base font-bold text-primary mb-2">@Ix("industries.hausdienste.title")</h4>
            <p class="text-on-surface-variant text-xs leading-relaxed mb-4">@IxHtml("industries.hausdienste.text")</p>
            <span class="text-xs font-bold text-secondary inline-flex items-center gap-1 mt-auto">@Ix("industries.moreLabel") <span class="material-symbols-outlined text-sm icon-directional">arrow_forward</span></span>
        </a>
        <a href="@IndustryHref("logistik")" class="card-hover p-6 bg-surface-container-lowest rounded-2xl flex flex-col items-start group hover:shadow-[0_24px_48px_-12px_rgba(28,27,27,0.04)] transition-all no-underline">
            <span class="material-symbols-outlined text-secondary text-3xl mb-4">local_shipping</span>
            <h4 class="text-base font-bold text-primary mb-2">@Ix("industries.logistik.title")</h4>
            <p class="text-on-surface-variant text-xs leading-relaxed mb-4">@IxHtml("industries.logistik.text")</p>
            <span class="text-xs font-bold text-secondary inline-flex items-center gap-1 mt-auto">@Ix("industries.moreLabel") <span class="material-symbols-outlined text-sm icon-directional">arrow_forward</span></span>
        </a>
    </div>
</section>

<!-- SPRACHEN -->
<section class="reveal bg-surface-container-low py-24 no-line-rule">
    <div class="max-w-7xl mx-auto px-8 flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="max-w-xl">
            <h2 class="text-3xl font-black tracking-tight mb-4">@Ix("languages.title")</h2>
            <p class="text-on-surface-variant">@IxHtml("languages.text")</p>
        </div>
        <div class="flex flex-wrap gap-3">
            <div class="px-4 py-2 bg-secondary/10 rounded-full text-sm font-bold text-secondary border border-secondary/20">@Ix("languages.badge.de")</div>
            <div class="px-4 py-2 bg-secondary/10 rounded-full text-sm font-bold text-secondary border border-secondary/20">@Ix("languages.badge.fr")</div>
            <div class="px-4 py-2 bg-secondary/10 rounded-full text-sm font-bold text-secondary border border-secondary/20">@Ix("languages.badge.it")</div>
            <div class="px-4 py-2 bg-secondary/10 rounded-full text-sm font-bold text-secondary border border-secondary/20">@Ix("languages.badge.en")</div>
            <div class="px-4 py-2 bg-surface-container-high rounded-full text-sm font-bold text-on-surface-variant">@Ix("languages.badge.more")</div>
        </div>
    </div>
</section>

<!-- CTA / KONTAKT -->
<section class="mx-8 my-24" id="kontakt">
    <div class="max-w-7xl mx-auto bg-[#141b2c] rounded-[2rem] py-24 px-8 text-center relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none">
            <div class="blob-animate absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-secondary rounded-full blur-[120px]"></div>
        </div>
        <h2 class="text-[2.5rem] md:text-[3rem] font-black text-white tracking-tighter mb-6 relative z-10">@Ix("cta.title")</h2>
        <p class="text-white/70 max-w-xl mx-auto mb-10 relative z-10">@IxHtml("cta.text")</p>
        <div class="relative z-10">
            <ContactForm Culture="@ResolvedCulture" />
        </div>
        <div class="flex flex-wrap justify-center gap-6 relative z-10 mt-8">
            <a href="https://github.com/HeribertG/Klacks" target="_blank" class="text-white/60 hover:text-white text-sm font-semibold inline-flex items-center gap-2 no-underline transition-colors">
                <span class="material-symbols-outlined text-base">code</span> @Sh("nav.github")
            </a>
        </div>
    </div>
</section>

@code {
    [Parameter] public string? Culture { get; set; }

    private string ResolvedCulture => SupportedCultures.Resolve(Culture).Code;

    private string Ix(string key) => ContentProvider.GetText(ResolvedCulture, "index", key);

    private MarkupString IxHtml(string key) => (MarkupString)Ix(key);

    private string Sh(string key) => ContentProvider.GetText(ResolvedCulture, "shared", key);

    private string IndustryHref(string pageKey) => ResolvedCulture == SupportedCultures.DefaultCode ? $"/{pageKey}" : $"/{ResolvedCulture}/{pageKey}";
}
