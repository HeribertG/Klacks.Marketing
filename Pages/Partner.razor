@page "/partner"
@page "/{culture}/partner"
@inject IPageContentProvider ContentProvider

<PageTitle>@GetText("pageTitle")</PageTitle>
<SeoHead PageKey="partner" Culture="@Culture" RoutePath="@EffectiveRoutePath" Title="@GetText("pageTitle")" DescriptionSource="@GetText("hero.subtitle")" />

<div class="min-h-screen bg-surface text-on-surface">
    <!-- Hero -->
    <section class="max-w-5xl mx-auto pt-24 pb-16 px-8 text-center">
        <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-6">
            @GetText("hero.title")
        </h1>
        <p class="text-xl text-on-surface-variant max-w-3xl mx-auto leading-relaxed">
            @((MarkupString)GetText("hero.subtitle"))
        </p>
    </section>

    <!-- Custom Industries — Haupt-USP -->
    <section class="max-w-4xl mx-auto py-16 px-8">
        <div class="bg-surface-container rounded-2xl p-8 md:p-12">
            <div class="flex items-center gap-3 mb-6">
                <span class="material-symbols-outlined text-secondary text-3xl">tune</span>
                <h2 class="text-2xl font-bold">@GetText("customIndustries.title")</h2>
            </div>
            <p class="text-on-surface-variant mb-8 leading-relaxed">
                @((MarkupString)GetText("customIndustries.text"))
            </p>
            <div class="grid md:grid-cols-2 gap-6 mb-8">
                <div class="flex gap-3 items-start">
                    <span class="material-symbols-outlined text-secondary mt-0.5">settings</span>
                    <div>
                        <h3 class="font-semibold mb-1">@GetText("customIndustries.items.0.title")</h3>
                        <p class="text-sm text-on-surface-variant">@GetText("customIndustries.items.0.text")</p>
                    </div>
                </div>
                <div class="flex gap-3 items-start">
                    <span class="material-symbols-outlined text-secondary mt-0.5">badge</span>
                    <div>
                        <h3 class="font-semibold mb-1">@GetText("customIndustries.items.1.title")</h3>
                        <p class="text-sm text-on-surface-variant">@GetText("customIndustries.items.1.text")</p>
                    </div>
                </div>
                <div class="flex gap-3 items-start">
                    <span class="material-symbols-outlined text-secondary mt-0.5">gavel</span>
                    <div>
                        <h3 class="font-semibold mb-1">@GetText("customIndustries.items.2.title")</h3>
                        <p class="text-sm text-on-surface-variant">@GetText("customIndustries.items.2.text")</p>
                    </div>
                </div>
                <div class="flex gap-3 items-start">
                    <span class="material-symbols-outlined text-secondary mt-0.5">bolt</span>
                    <div>
                        <h3 class="font-semibold mb-1">@GetText("customIndustries.items.3.title")</h3>
                        <p class="text-sm text-on-surface-variant">@GetText("customIndustries.items.3.text")</p>
                    </div>
                </div>
            </div>
            <div class="bg-surface-container-high rounded-xl p-6 text-center">
                <p class="text-on-surface font-medium">
                    @((MarkupString)GetText("customIndustries.cta"))
                </p>
            </div>
        </div>
    </section>

    <!-- Vorteile für Berater -->
    <section class="max-w-4xl mx-auto py-16 px-8">
        <h2 class="text-2xl font-bold mb-8">@GetText("benefits.title")</h2>
        <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-surface-container rounded-xl p-6">
                <span class="material-symbols-outlined text-secondary text-2xl mb-3">security</span>
                <h3 class="font-bold mb-2">@GetText("benefits.items.0.title")</h3>
                <p class="text-sm text-on-surface-variant">@GetText("benefits.items.0.text")</p>
            </div>
            <div class="bg-surface-container rounded-xl p-6">
                <span class="material-symbols-outlined text-secondary text-2xl mb-3">psychology</span>
                <h3 class="font-bold mb-2">@GetText("benefits.items.1.title")</h3>
                <p class="text-sm text-on-surface-variant">@GetText("benefits.items.1.text")</p>
            </div>
            <div class="bg-surface-container rounded-xl p-6">
                <span class="material-symbols-outlined text-secondary text-2xl mb-3">scale</span>
                <h3 class="font-bold mb-2">@GetText("benefits.items.2.title")</h3>
                <p class="text-sm text-on-surface-variant">@GetText("benefits.items.2.text")</p>
            </div>
        </div>
    </section>

    <!-- Integration -->
    <section class="max-w-4xl mx-auto py-16 px-8">
        <h2 class="text-2xl font-bold mb-8">@GetText("integration.title")</h2>
        <div class="bg-surface-container rounded-2xl p-8">
            <div class="grid md:grid-cols-2 gap-8">
                <div>
                    <h3 class="font-bold mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-secondary">api</span> @GetText("integration.items.0.title")
                    </h3>
                    <div class="text-sm text-on-surface-variant space-y-1">
                        @((MarkupString)GetText("integration.items.0.text"))
                    </div>
                </div>
                <div>
                    <h3 class="font-bold mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-secondary">hub</span> @GetText("integration.items.1.title")
                    </h3>
                    <div class="text-sm text-on-surface-variant space-y-1">
                        @((MarkupString)GetText("integration.items.1.text"))
                    </div>
                </div>
                <div>
                    <h3 class="font-bold mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-secondary">deploy</span> @GetText("integration.items.2.title")
                    </h3>
                    <div class="text-sm text-on-surface-variant space-y-1">
                        @((MarkupString)GetText("integration.items.2.text"))
                    </div>
                </div>
                <div>
                    <h3 class="font-bold mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-secondary">translate</span> @GetText("integration.items.3.title")
                    </h3>
                    <div class="text-sm text-on-surface-variant space-y-1">
                        @((MarkupString)GetText("integration.items.3.text"))
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="max-w-4xl mx-auto py-16 px-8">
        <div class="bg-[#141b2c] rounded-2xl py-16 px-8 text-center">
            <h2 class="text-2xl font-black text-white mb-4">@GetText("cta.title")</h2>
            <p class="text-white/70 max-w-xl mx-auto mb-8">
                @GetText("cta.text")
            </p>
            <div class="flex flex-wrap justify-center gap-4">
                <a href="/installation" class="bg-secondary text-white px-8 py-4 rounded-xl font-bold hover:opacity-90 transition-all no-underline inline-flex items-center gap-2">
                    <span class="material-symbols-outlined">download</span> Installation
                </a>
                <a href="https://github.com/HeribertG/Klacks.Api" class="border border-white/30 text-white px-8 py-4 rounded-xl font-bold hover:bg-white/10 transition-all no-underline inline-flex items-center gap-2">
                    <span class="material-symbols-outlined">code</span> GitHub
                </a>
            </div>
        </div>
    </section>
</div>

@code {
    [Parameter] public string? Culture { get; set; }

    private string EffectiveRoutePath => "partner";

    private string ResolvedCulture => SupportedCultures.Resolve(Culture).Code;

    private string GetText(string key) => ContentProvider.GetText(ResolvedCulture, "partner", key);
}
