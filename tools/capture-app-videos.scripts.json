  "timeline-24h": {
    "de": {
      "title": "Tagesverlauf über 24 Stunden",
      "videoLabel": "Video: Dienstplan als 24-Stunden-Tagesverlauf",
      "caption": "Echte Aufnahme aus Klacks mit Demo-Daten: Ein Klick schaltet den Dienstplan von der Tabelle in den Tagesverlauf — über 24 Stunden sehen Sie Nacht-, Früh- und Spätschichten als Zeitbalken und erkennen Lücken und Überschneidungen auf einen Blick.",
      "steps": [
        "Schalter „Tagesverlauf“ in der Kopfzeile des Dienstplans einschalten",
        "Bereich „24 Std-Ansicht“ wählen",
        "Durch die Woche und zu weiteren Personen scrollen — Nachtschichten reichen sichtbar über Mitternacht"
      ]
    }
  },
  "timeline-day-dragdrop": {
    "de": {
      "title": "Schicht in den Tagesverlauf ziehen",
      "videoLabel": "Video: Schicht per Drag & Drop im Tagesverlauf einplanen",
      "caption": "Echte Aufnahme aus Klacks mit Demo-Daten: In der Tagesansicht von 6 bis 19 Uhr ziehen Sie eine Schicht aus der Schichtliste direkt auf eine Person — die Schicht erscheint sofort als Zeitbalken zur richtigen Uhrzeit, mitten im übrigen Dienstplan.",
      "steps": [
        "Im Tagesverlauf den Bereich „Tagesansicht“ (6–19 Uhr) wählen",
        "Schicht in der Liste „Schichten“ unten am gewünschten Tag greifen",
        "Auf die Zeile der Person ziehen und loslassen — Klacks plant die Schicht ein"
      ]
    }
  },
